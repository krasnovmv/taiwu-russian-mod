{
  "name": "taiwu",
  "version": "1.0.0",
  "description": "Taiwu localization toolkit (EN→RU translation with CN cross-validation)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test test/**/*.test.ts",
    "roundtrip": "node --env-file-if-exists=.env --import tsx src/cli/roundtrip.ts",
    "status": "node --env-file-if-exists=.env --import tsx src/cli/status.ts",
    "estimate": "node --env-file-if-exists=.env --import tsx src/cli/estimate.ts",
    "translate": "node --env-file-if-exists=.env --import tsx src/cli/translate.ts",
    "translate-all": "npm run translate -- --all --route --threshold 1000 --max-len 1000",
    "rebuild-tm": "npm run translate-all -- --cache-only",
    "validate": "node --env-file-if-exists=.env --import tsx src/cli/validate.ts",
    "apply": "node --env-file-if-exists=.env --import tsx src/cli/apply.ts",
    "apply-all": "npm run apply -- --all",
    "backup": "node --env-file-if-exists=.env --import tsx src/cli/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx src/cli/backup.ts --restore",
    "sync": "node --env-file-if-exists=.env --import tsx src/cli/sync.ts",
    "glossary:candidates": "node --env-file-if-exists=.env --import tsx src/cli/glossary-candidates.ts",
    "glossary:pull": "node --env-file-if-exists=.env --import tsx src/cli/glossary-pull.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "private": true,
  "dependencies": {
    "@yandex-cloud/nodejs-sdk": "^3.2.0",
    "cli-progress": "^3.12.0",
    "json5": "^2.2.3"
  }
}
