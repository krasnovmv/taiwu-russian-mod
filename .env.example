# Copy to .env and fill in. Loaded automatically by npm scripts via Node's
# native --env-file-if-exists=.env (no dotenv dependency). Optional file.

# --- Yandex Cloud Translate (required for `npm run translate -- ... --engine yandex`) ---
# IAM token, ~12h lifetime: yc iam create-token
TAIWU_YANDEX_IAM_TOKEN=
# Yandex Cloud folder id
TAIWU_YANDEX_FOLDER_ID=

# --- LM Studio (local LLM) for `npm run translate -- ... --engine lmstudio` ---
# All optional; defaults target a local server with a model already loaded.
#TAIWU_LMSTUDIO_BASE_URL=http://localhost:1234/v1
#TAIWU_LMSTUDIO_MODEL=
#TAIWU_LMSTUDIO_CONCURRENCY=4

# --- Optional overrides (defaults work out of the box) ---
# Source EN language dir (default: ./Language_EN junction)
#TAIWU_LANG_DIR=
# CN reference dir (default: sibling Language_CN of the EN dir)
#TAIWU_LANG_CN_DIR=
# Translation-memory output dir (default: ./tm)
#TAIWU_TM_DIR=
# Glossary file (default: ./data/glossary.json)
#TAIWU_GLOSSARY=
# Approximate Yandex price for `npm run estimate`, RUB per 1M chars (default: 419)
#TAIWU_YANDEX_RATE_RUB_PER_M=
