# Copy to .env and fill in. Loaded automatically by npm scripts via Node's
# native --env-file-if-exists=.env (no dotenv dependency). Optional file.

# Yandex: credentials always come from the `yc` CLI (run `yc init` once) — no
# variables needed.

# --- LM Studio (local LLM), all optional ---
#TAIWU_LMSTUDIO_BASE_URL=http://localhost:1234/v1
#TAIWU_LMSTUDIO_MODEL=
#TAIWU_LMSTUDIO_CONCURRENCY=4

# --- Output ---
# RU output dir for `apply` (default: ./Language_RU, the junction into the game).
# Set to a project path to keep output local instead of deploying to the game.
#TAIWU_LANG_RU_DIR=

# --- Source scope ---
# Include the Event_Languages quest text (outside StreamingAssets) in the
# pipeline. OFF by default; set to 1 to fold it into translate/apply/status/
# estimate.
#TAIWU_EVENTS=1
