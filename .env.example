# Copy to .env and fill in. Loaded automatically by npm scripts via Node's
# native --env-file-if-exists=.env (no dotenv dependency). Optional file.

# Yandex: credentials always come from the `yc` CLI (run `yc init` once) — no
# variables needed.

# --- LM Studio (local LLM), all optional ---
# Used by `translate --engine lmstudio` and by the LLM judge (`npm run judge`).
# Any OpenAI-compatible server works, not just LM Studio — point BASE_URL at it.
# The judge takes its model from TAIWU_LMSTUDIO_MODEL (NOT TAIWU_JUDGE_MODEL,
# which is the Yandex one), or from `--model`; unset = first model the server lists.
#TAIWU_LMSTUDIO_BASE_URL=http://localhost:1234/v1
#TAIWU_LMSTUDIO_MODEL=
#TAIWU_LMSTUDIO_CONCURRENCY=4
# Reasoning is switched off by default (`reasoning_effort: "none"`) — it makes a
# thinking model like Qwen3 ~70x faster and the trace never reaches the output.
# Servers that reject that value (an OpenAI-backed one 400s with "expected
# low|medium|high") need a level they accept here, or an empty value to leave the
# field out of the request entirely.
#TAIWU_LMSTUDIO_REASONING_EFFORT=none

# --- LLM judge (`npm run judge-all`) ---
# Backend: yandex (default) or lmstudio. Only swaps the transport — prompt, schema
# and QA gates are identical, so switching does NOT re-judge anything.
#TAIWU_JUDGE_ENGINE=yandex
# The judge runs on Yandex AI Studio (Foundation Models). Credentials: an API key
# with the yc.ai.foundationModels.execute scope is PREFERRED (it does not expire,
# so it survives a long run); without one, an IAM token from the `yc` CLI is used
# and refreshed automatically. Folder id falls back to `yc config get folder-id`.
#TAIWU_YANDEX_API_KEY=
#TAIWU_YANDEX_FOLDER_ID=
# Model: yandexgpt/latest (default) or the cheaper yandexgpt-lite/latest; a full
# gpt://<folder>/<model> URI is also accepted. Override per run with --model.
#TAIWU_JUDGE_MODEL=yandexgpt/latest
#TAIWU_JUDGE_MAX_TOKENS=2000
#TAIWU_JUDGE_CONCURRENCY=4
#TAIWU_JUDGE_CHECKPOINT=25
# Set to 0 to drop the per-error "explanation" field: smaller model output (helps
# a tight context window), at the cost of a bare severity/category in the report.
#TAIWU_JUDGE_EXPLANATIONS=1
# Bump to invalidate every past verdict (e.g. after editing the judge prompt).
#TAIWU_JUDGE_VERSION=1
# Replace the built-in judge system prompt (src/judge/prompt.ts) wholesale.
#TAIWU_JUDGE_PROMPT_FILE=

# --- Output ---
# Output language slot the pack is written to. The game has no Russian slot, so
# the default hijacks Korean (KO): pick that language in-game to play in Russian.
# This ONE knob drives both layouts — the pack dir (Language_<LANG>) and the
# event filename suffix (_Language_<LANG>.txt). Set EN to overwrite the English
# slot (back up first — EN is also the source).
#TAIWU_OUT_LANG=KO

# Collect ALL output (pack + events) under a local folder instead of writing into
# the game, preserving the FULL game-root layout (so the folder can be dropped
# straight onto an install: <dir>/The Scroll of Taiwu_Data/StreamingAssets/
# Language_<LANG>/…, <dir>/Event/EventLanguages/…). Unset = write in-place.
#TAIWU_OUTPUT_DIR=output

# Explicit path override for JUST the main pack dir (wins over the two above).
# E.g. to write the pack somewhere bespoke while events stay in-place.
#TAIWU_LANG_RU_DIR=

# --- Source scope ---
# Include the ROOT Event_Languages quest text (the big game-root Event folder,
# outside StreamingAssets) in the pipeline. OFF by default; set to 1 to fold it
# into translate/apply/status/estimate. The per-DLC quest packs (Event_DLC) are
# always included regardless of this flag.
#TAIWU_EVENTS=1
