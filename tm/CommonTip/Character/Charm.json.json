    "paragraphs/0/atoms/0/content": {
      "en": "Charm represents a character's physical attractiveness and personal charisma...",
      "cn": "魅力代表着人物的相貌美丑和人格魅力…",
      "ru": "Обаяние - это физическая привлекательность персонажа и его личная харизма...",
      "status": "machine",
      "srcHash": "c844b4e7df368e7b",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:23:10.438Z"
    },
    "paragraphs/0/atoms/2/content": {
      "en": "<SpName=ui9_icon_mousetip_point_0> Charm does not apply to young characters.",
      "cn": "<SpName=ui9_icon_mousetip_point_0>年幼之人的魅力没有高低之分",
      "ru": "<SpName=ui9_icon_mousetip_point_0> Очарование не распространяется на юных персонажей.",
      "status": "machine",
      "srcHash": "56e93f85622caa72",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:23:10.438Z"
    },
    "paragraphs/0/atoms/3/content": {
      "en": "<SpName=ui9_icon_mousetip_point_0> Being Disheveled drastically reduces a character's Charm.",
      "cn": "<SpName=ui9_icon_mousetip_point_0>衣不蔽体会导致人物的魅力大减",
      "ru": "<SpName=ui9_icon_mousetip_point_0> Растрепанность резко снижает обаяние персонажа.",
      "status": "machine",
      "srcHash": "ded4a3ef325911c4",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:23:10.438Z"
    },
    "paragraphs/0/atoms/5/content": {
