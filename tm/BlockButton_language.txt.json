    "Summary_0": {
      "en": "Foodstuff-rich tiles yield more Foodstuff when gathered, and offer a higher chance of obtaining Foodstuff Reagent...",
      "cn": "食材越丰富的地格,采集获得的食材越多,越可能额外获得食材引子…",
      "ru": "Ячейки, богатые ингредиентами, при сборе дают больше ингредиентов и повышают вероятность получения реагента для ингредиентов...",
      "status": "judged",
      "srcHash": "e598926fbd04df04",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "885dfb402ab86c73"
    },
    "Summary_1": {
      "en": "Wood-rich tiles yield more Wood when gathered, and offer a higher chance of obtaining Wood Reagents...",
      "cn": "木料越丰富的地格,采集获得的木料越多,越可能额外获得木料引子…",
      "ru": "Плитки, богатые древесиной, дают больше древесины при сборе и с большей вероятностью позволяют получить дополнительные реагенты для обработки древесины...",
      "status": "judged",
      "srcHash": "ad494bbc6ecd05ec",
      "engine": "yandex",
      "updatedAt": "2026-08-21T07:11:42.133Z",
      "judgeHash": "39cca705235a187a"
    },
    "Summary_2": {
      "en": "Metal-rich tiles yield more Metal when gathered, and offer a higher chance of obtaining Metal Reagents...",
      "cn": "金铁越丰富的地格,采集获得的金铁越多,越可能额外获得金铁引子…",
      "ru": "Богатые металлом плитки при сборе дают больше металла и повышают вероятность получения металлических реагентов...",
      "status": "judged",
      "srcHash": "78786b732b0901dd",
      "engine": "yandex",
      "updatedAt": "2026-08-21T07:11:42.133Z",
      "judgeHash": "63c2bba875efc722"
    },
    "Summary_3": {
      "en": "Jade-rich tiles yield more Jade when gathered, and offer a higher chance of obtaining Jade Reagents...",
      "cn": "玉石越丰富的地格,采集获得的玉石越多,越可能额外获得玉石引子…",
      "ru": "Плитки, богатые нефритом, при сборе дают больше нефрита и повышают шанс получить нефритовый катализатор...",
      "status": "judged",
      "srcHash": "945e13495a281d00",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:27:10.184Z",
      "judgeHash": "85b73269ab46a28a"
    },
    "Summary_4": {
      "en": "Fabric-rich tiles yield more Fabric when gathered, and offer a higher chance of obtaining Fabric Reagents...",
      "cn": "织物越丰富的地格,采集获得的织物越多,越可能额外获得织物引子…",
      "ru": "Плитки с высоким содержанием ткани при сборке дают больше ткани и повышают вероятность получения тканевых реагентов...",
      "status": "machine",
      "srcHash": "aac0c833886d6af3",
      "engine": "yandex",
      "updatedAt": "2026-07-16T22:39:44.118Z",
      "judgeHash": "ec0cb638f41a24cc"
    },
    "Summary_5": {
      "en": "Herb-rich tiles yield more herbs when gathered, and offer a higher chance of obtaining Herb Reagents...",
      "cn": "药材越丰富的地格,采集获得的药材越多,越可能额外获得药材引子…",
      "ru": "На участках, богатых травами, при сборе получается больше трав, и выше шанс получить дополнительные травяные ингредиенты...",
      "status": "judged",
      "srcHash": "faa8ae117fe6b75c",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "a0f1f9c31e99e429"
    },
