    "ba98df43-6a94-4244-9fa3-ebd0cd7b8460/EventContent": {
      "en": "Choose a cultivation method:<NL><NL>(Call Dialog here, passing in<NL>ArgBox.Nurturance as the nurturing policy,<NL>ArgBox.ConfirmEvent as the confirmation event,<NL>and ArgBox.CancelEvent as the return event.)",
      "cn": null,
      "ru": "Выберите метод культивирования:<NL><NL>(Вызовите диалоговое окно здесь, передав<NL>ArgBox.Nurturance в качестве политики культивирования,<NL>ArgBox.ConfirmEvent в качестве события подтверждения,<NL>и ArgBox.cancelEvent в качестве события возврата.)",
      "status": "machine",
      "srcHash": "9895e042bcffc38c",
      "engine": "yandex",
      "updatedAt": "2026-06-21T23:09:46.516Z"
    },
