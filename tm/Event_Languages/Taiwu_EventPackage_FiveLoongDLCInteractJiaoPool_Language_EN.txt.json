    "daa7368c-615c-4ebb-8229-e15553601ad2/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name /> gathers the villagers and asks them to encircle the area with rocks, flowers, and plants, then pour clear spring water into it.<NL>With the rocks arching and embracing, and the water a faint azure, it is indeed an excellent habitat for the Jiao.<NL><Character key=RoleTaiwu str=Name /> carefully picks up the Jiao egg and place it in the pool, patiently awaiting its birth...",
      "cn": null,
      "ru": null,
      "status": "pending",
      "srcHash": "396ad17e9e97b85c",
      "engine": null,
      "updatedAt": null
    },
