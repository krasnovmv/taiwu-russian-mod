      "updatedAt": null
    },
    "0e03bbad-ac1a-4c69-adaf-89798ee07009/EventContent": {
      "en": "\"Your soul... it's no longer whole. I can barely tell who you are anymore...\"",
      "cn": "“你的魂魄已似是而非……你究竟是谁，我亦再难辨清了……”",
      "ru": null,
      "status": "pending",
      "srcHash": "5e9ca824623e886f",
      "engine": null,
      "updatedAt": null
    },
    "0e03bbad-ac1a-4c69-adaf-89798ee07009/Option_1": {
