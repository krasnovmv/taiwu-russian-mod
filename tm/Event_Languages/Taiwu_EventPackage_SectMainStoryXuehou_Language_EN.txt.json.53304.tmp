    "0e03bbad-ac1a-4c69-adaf-89798ee07009/Option_2": {
      "en": "(Execute Jixi...)",
      "cn": "（诛杀姬穸……）",
      "ru": null,
      "status": "pending",
      "srcHash": "0c7d975e34a78c9d",
      "engine": null,
      "updatedAt": null
    },
    "0e03bbad-ac1a-4c69-adaf-89798ee07009/Option_3": {
      "en": "(Leave her be...)",
      "cn": "（任她在此……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "a8a37506f858c30d",
      "engine": null,
      "updatedAt": null
    },
    "57c2d4bb-2bb6-4bff-a0e3-173600511e67/EventContent": {
      "en": "\"Your soul... it's no longer whole. I can barely tell who you are anymore...\"",
      "cn": "“你的魂魄已似是而非……你究竟是谁，我亦再难辨清了……”",
      "ru": null,
      "status": "pending",
      "srcHash": "5e9ca824623e886f",
      "engine": null,
      "updatedAt": null
    },
    "57c2d4bb-2bb6-4bff-a0e3-173600511e67/Option_1": {
      "en": "Now... where are you heading...?",
      "cn": "如今……你要去往何处……\n",
      "ru": null,
      "status": "pending",
      "srcHash": "b1c2f492d3071a32",
      "engine": null,
      "updatedAt": null
    },
    "a2aab1f5-6070-4d3e-933a-fc9d9bb98522/EventContent": {
      "en": "\"I have no place to return to... I would wander the heavens and earth...<NL>You're not the one I've been waiting for... Why don't we just part ways here...\"",
      "cn": "“我已无归处……游荡天地……<NL>既然阴差阳错……不如就此别过……”",
      "ru": null,
      "status": "pending",
      "srcHash": "0a6dfbf6bfd4db1c",
      "engine": null,
      "updatedAt": null
    },
    "a2aab1f5-6070-4d3e-933a-fc9d9bb98522/Option_1": {
      "en": "(Guess that's how it has to be...)",
      "cn": "（只好如此……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "6e390e39dac24598",
      "engine": null,
      "updatedAt": null
    },
    "904f2d72-3ba0-4631-9c5d-0b3591ee0e16/EventContent": {
      "en": "\"You resemble <Gender key=AwakeJixiTaiwuGender str=Gender/> so closely...<NL>like the moon reflected on water, like a face in a mirror. But no matter how similar, you are not the one I've been waiting for.\"",
      "cn": "“你与<Gender key=AwakeJixiTaiwuGender str=Gender/>何其相似……<NL>彷如水中月、镜中影，但终究不是我所等候的那个人……”",
      "ru": null,
      "status": "pending",
      "srcHash": "bbc8b5a4825fd8e0",
      "engine": null,
      "updatedAt": null
    },
    "904f2d72-3ba0-4631-9c5d-0b3591ee0e16/Option_1": {
      "en": "(Why the bloodlust...)",
      "cn": "（为何嗜血……）",
      "ru": null,
      "status": "pending",
      "srcHash": "7524c5277772a81f",
      "engine": null,
      "updatedAt": null
    },
    "904f2d72-3ba0-4631-9c5d-0b3591ee0e16/Option_2": {
      "en": "(Execute Jixi...)",
      "cn": "（诛杀姬穸……）",
      "ru": null,
      "status": "pending",
      "srcHash": "0c7d975e34a78c9d",
      "engine": null,
      "updatedAt": null
    },
    "904f2d72-3ba0-4631-9c5d-0b3591ee0e16/Option_3": {
      "en": "(Leave her be...)",
      "cn": "（任她在此……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "a8a37506f858c30d",
      "engine": null,
      "updatedAt": null
    },
    "74b2785a-0dd5-49ae-85be-d959dbe75f1e/EventContent": {
      "en": "\"Mortal fate is fickle, and the flesh is easily destroyed. Yet your soul—I have always known it...\"",
      "cn": "“尘世无常，肉身易殒。然而你的魂魄，我却始终认得……”",
      "ru": null,
      "status": "pending",
      "srcHash": "7d22f3c65d2a9d8d",
      "engine": null,
      "updatedAt": null
    },
    "74b2785a-0dd5-49ae-85be-d959dbe75f1e/Option_1": {
      "en": "(Let out a sigh...)",
      "cn": "（一声叹息……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "d780bb121081dfaf",
      "engine": null,
      "updatedAt": null
    },
    "eff859c5-6160-4515-8d0a-d68fe5300f62/EventContent": {
      "en": "The past has slipped away, never to return.<NL>Jixi is no longer the person she once was. Her ghostly nature has taken hold.<NL>If <Character key=RoleTaiwu str=Name/> chooses to strike now, there may be no turning back...<NL><NL><color=#lightgrey>(One blow and the die is cast. Strike down Jixi?)</color>",
      "cn": "往事既去，再不可追。<NL>如今姬穸鬼性难抑，已非昔时，<NL><Character key=RoleTaiwu str=Name/>再欲诛杀，更是难免一战，只怕此番出手，便是覆水难收……<NL><NL><color=#lightgrey>（生死一念，不知可要出手诛杀姬穸……）</color>",
      "ru": null,
      "status": "pending",
      "srcHash": "15bf00de12732714",
      "engine": null,
      "updatedAt": null
    },
    "eff859c5-6160-4515-8d0a-d68fe5300f62/Option_1": {
      "en": "(Execute Jixi...)",
      "cn": "（诛杀姬穸……）",
      "ru": null,
      "status": "pending",
      "srcHash": "0c7d975e34a78c9d",
      "engine": null,
      "updatedAt": null
    },
    "eff859c5-6160-4515-8d0a-d68fe5300f62/Option_2": {
      "en": "(Leave her be...)",
      "cn": "（任她在此……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "a8a37506f858c30d",
      "engine": null,
      "updatedAt": null
    },
    "7187d2fe-4bfe-4e3f-bf90-3b8ad9c8019c/EventContent": {
      "en": "\"You... have passed through death and rebirth, yet your spirit has not faded. Even across a thousand lifetimes, I will still wait for your return...\"",
      "cn": "“是你……死生轮回，魂灵未泯，纵有万劫千生，我仍会等你归来……”",
      "ru": null,
      "status": "pending",
      "srcHash": "a93bc032332bba52",
      "engine": null,
      "updatedAt": null
    },
    "7187d2fe-4bfe-4e3f-bf90-3b8ad9c8019c/Option_1": {
      "en": "(Let out a sigh...)",
      "cn": "（一声叹息……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "d780bb121081dfaf",
      "engine": null,
      "updatedAt": null
    },
    "b91d39c6-6544-4b8b-8437-0272ceb1792a/EventContent": {
      "en": "One night, the sky is high and cold, with patches of dark clouds drifting and gathering, and occasional hoarse bird cries.<NL>For days, mysterious events at midnight had unsettled Taiwu Village,<NL>and now the oppressive gloom caused most villagers to stay indoors.<NL>Only <Character key=RoleTaiwu str=Name/> remained curious, patrolling the village to calm the people...",
      "cn": "是日，天高气寒，片片阴云时散时聚，另有几声喑哑鸟鸣不时划过，<NL>连日以来，太吾村中本有夜半诡事未明，<NL>此时更添这般沉闷之状，压得村民多闭门居屋，<NL>唯独<Character key=RoleTaiwu str=Name/>心有所惑，仍在村中巡视，安民定心……",
      "ru": null,
      "status": "pending",
      "srcHash": "564e448fb302e035",
      "engine": null,
      "updatedAt": null
    },
    "b91d39c6-6544-4b8b-8437-0272ceb1792a/Option_1": {
      "en": "(Just hope nothing happens in the village...)",
      "cn": "（只盼村中无事便好……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "c497abc0e5f947a2",
      "engine": null,
      "updatedAt": null
    },
    "d474028c-ed9e-41bb-8fbf-0381570acca1/EventContent": {
      "en": "After several rounds, every household appear normal,<NL>yet Jixi could not be found, even outside the village.<NL>As the clouds thicken and the wind grows cold, <Character key=RoleTaiwu str=Name/> could not help but grow anxious...",
      "cn": "连巡数回，户户皆无异状，<NL>偏却寻不得姬穸所在，便是村外也不见她的踪影，<NL>眼看阴云渐浓，幽风渐凉，<Character key=RoleTaiwu str=Name/>不免心生焦急……",
      "ru": null,
      "status": "pending",
      "srcHash": "c2bde222ec4d5f94",
      "engine": null,
      "updatedAt": null
    },
    "d474028c-ed9e-41bb-8fbf-0381570acca1/Option_1": {
      "en": "(Look for her...)",
      "cn": "（前去寻找……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "29209b28a4de8eb5",
      "engine": null,
      "updatedAt": null
    },
    "deb1d139-4f25-461a-97bd-1d98aeb4a782/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> knocks on door after door, yet still could not find Jixi's whereabouts.<NL><Character key=RoleTaiwu str=Name/> is at a loss, and could only try to recall what Jixi has said and liked in the past,<NL>all the strange events since Jixi entered the village gradually come to mind...",
      "cn": "<Character key=RoleTaiwu str=Name/>挨家叩问，仍是不得姬穸下落，<NL><Character key=RoleTaiwu str=Name/>一时无从找起，只得细想往日姬穸所言所好，<NL>渐忆起姬穸入村以来种种异事……",
      "ru": null,
      "status": "pending",
      "srcHash": "13b0976969f9239c",
      "engine": null,
      "updatedAt": null
    },
    "deb1d139-4f25-461a-97bd-1d98aeb4a782/Option_1": {
      "en": "(Recall carefully...)",
      "cn": "（仔细回想……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "253bd922aa9b10da",
      "engine": null,
      "updatedAt": null
    },
    "a0452ff4-8c0a-4fa6-9d6a-345e31f34a8a/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> walks several miles, when suddenly a rolling stench drifts by.<NL>The closer to the dark clouds, the stronger the pungent smell becomes,<NL>with faint traces of warmth seeping out from the cold wind...",
      "cn": "<Character key=RoleTaiwu str=Name/>行出数里，忽有滚滚腥膻之气荡来，<NL>愈是临近阴云所在，其刺鼻之感愈发强烈，<NL>更有几丝温热之感自冷风中钻出……",
      "ru": null,
      "status": "pending",
      "srcHash": "3f29e6f73b1ef54f",
      "engine": null,
      "updatedAt": null
    },
    "a0452ff4-8c0a-4fa6-9d6a-345e31f34a8a/Option_1": {
      "en": "(Uneasy, quicken pace...)",
      "cn": "（心下不安，加快脚步……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "41cad06d4499adf9",
      "engine": null,
      "updatedAt": null
    },
    "ff51c680-ed6a-4a21-a1ff-99f0b34584b5/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> searches several times, still finding no sign of Jixi.<NL>He has to return indoors for a moment to think carefully if he overlooked anything...",
      "cn": "<Character key=RoleTaiwu str=Name/>复寻数回，仍是不见姬穸下落，<NL>只得暂且回屋细想可有遗漏之处……",
      "ru": null,
      "status": "pending",
      "srcHash": "07b73bfa3cfea051",
      "engine": null,
      "updatedAt": null
    },
    "ff51c680-ed6a-4a21-a1ff-99f0b34584b5/Option_1": {
      "en": "(Ponder alone...)",
      "cn": "（独自沉思……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "e544f2dc44354acf",
      "engine": null,
      "updatedAt": null
    },
    "b132b42f-dbd3-4a69-a336-f1a2f9f5f1c3/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> walks several miles, suddenly spotting red mist spreading in the distance.<NL>The mist swirls uncertainly under the dark clouds, then abruptly tightens and falls straight into the forest,<NL>as if being violently drawn in by something...",
      "cn": "<Character key=RoleTaiwu str=Name/>行出数里，忽见得远处正有几抹红雾弥散，<NL>红雾本于阴云之下腾转不定，随后骤然一紧，直直跌入山林间，<NL>似是正被何物猛然吸纳……",
      "ru": null,
      "status": "pending",
      "srcHash": "7edec112a08ff0b0",
      "engine": null,
      "updatedAt": null
    },
    "b132b42f-dbd3-4a69-a336-f1a2f9f5f1c3/Option_1": {
      "en": "(Such a display—surely the one responsible must have tremendous inner qi...)",
      "cn": "（这般举动，只怕施为者内力惊人……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "2d2a60ff8dd27ca7",
      "engine": null,
      "updatedAt": null
    },
    "a87bae96-1e69-48b3-a336-38cb234467be/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> goes to the place where Jixi has been again, observing closely, yet still finds no trace.<NL>Only the cawing of crows above disturbs <Character key=RoleTaiwu str=Name/>, rising annoyance filling the mind, pondering where Jixi could possibly have gone...",
      "cn": "<Character key=RoleTaiwu str=Name/>又去往曾与姬穸所处之地细观，仍未寻得姬穸，<NL>唯听得头顶鸦雀的嘶鸣声不止，<NL>扰的<Character key=RoleTaiwu str=Name/>心中烦闷渐起，兀自回想姬穸究竟能去何处……",
      "ru": null,
      "status": "pending",
      "srcHash": "802c981ca1e49417",
      "engine": null,
      "updatedAt": null
    },
    "a87bae96-1e69-48b3-a336-38cb234467be/Option_1": {
      "en": "(Think carefully...)",
      "cn": "（仔细思索……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "6a378f4679bb8466",
      "engine": null,
      "updatedAt": null
    },
    "ccf0be29-a8c4-418e-8ac7-13317cd9a473/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name/> walks several miles, suddenly hearing a few sharp cries fall from the sky.<NL>Looking up, dozens of jet-black crows circle above,<NL>their harsh cries rising as they swoop swiftly toward the distance...",
      "cn": "<Character key=RoleTaiwu str=Name/>行出数里，忽听得数声尖利嘶鸣坠空而落，<NL>抬头望去，即见得数十只油黑乌鸦正盘旋于空，<NL>群鸦高声啼叫着，正疾疾向着远处飞扑而去……",
      "ru": null,
      "status": "pending",
      "srcHash": "813d79ea70f1b459",
      "engine": null,
      "updatedAt": null
    },
    "ccf0be29-a8c4-418e-8ac7-13317cd9a473/Option_1": {
      "en": "(The crows' gathering is ill-omened; must find Jixi quickly...)",
      "cn": "（群鸦啸聚，恐非吉兆，还需尽快寻得姬穸……）\n",
      "ru": null,
      "status": "pending",
      "srcHash": "0502de85995bce40",
      "engine": null,
      "updatedAt": null
    },
    "ec927042-7a51-4968-b559-f2fbf1a95aa3/EventContent": {
      "en": "nan",
      "cn": "\n",
      "ru": null,
      "status": "pending",
      "srcHash": "910ba46f7648772c",
      "engine": null,
      "updatedAt": null
    },
    "c6af02db-2934-40d2-a80b-403915ea38a9/EventContent": {
      "en": "nan",
      "cn": "\n",
      "ru": null,
      "status": "pending",
      "srcHash": "910ba46f7648772c",
      "engine": null,
      "updatedAt": null
    },
    "afac7b45-6bab-4223-a2e9-2720eb913673/EventContent": {
      "en": "In an instant, a flash of blood light erupts, red mist scatters, and eerie ghostly energy shoots straight at the zombie old man's face.<NL>The sound of flesh tearing rings out; the old man screams in agony, and Jixi has shattered the old man's steel-like body!",
      "cn": "霎时间，血光乍起，红雾四散，森森鬼气直取僵尸老人面门，<NL>只听闻血肉撕裂之音，老人惨呼出声，姬穸竟就此破了老人的钢筋铁骨！",
      "ru": null,
      "status": "pending",
      "srcHash": "c330d4fe67aeb327",
      "engine": null,
      "updatedAt": null
    },
    "afac7b45-6bab-4223-a2e9-2720eb913673/Option_1": {
      "en": "Jixi!",
      "cn": "姬穸！\n",
      "ru": null,
      "status": "pending",
      "srcHash": "a2132f13233c264e",
      "engine": null,
      "updatedAt": null
    }
  }
}
