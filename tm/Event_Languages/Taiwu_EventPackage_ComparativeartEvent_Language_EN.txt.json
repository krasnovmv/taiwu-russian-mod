    "a7dcf844-6a48-4d83-8995-9c02e14e0106/EventContent": {
      "en": "\"Oh? What do you want to offer?\"",
      "cn": "“哦？你要送我什么……”",
      "ru": "- О? Что ты хочешь предложить?\"",
      "status": "machine",
