    "414051c5-a21c-413a-ab21-de78bc60b661/EventContent": {
      "en": "You're underestimating me. That's not enough. However, if there are more...",
      "cn": "区区此等物件，莫不是小瞧了在下。不过若有其他珍宝……",
      "ru": "Ты недооцениваешь меня. Этого недостаточно. Однако, если их будет больше...",
      "status": "machine",
      "srcHash": "1292b3387aec17fc",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
    "414051c5-a21c-413a-ab21-de78bc60b661/Option_1": {
      "en": "How about this?",
      "cn": "此物如何？",
      "ru": "Как насчет этого?",
      "status": "machine",
      "srcHash": "270fbbbcb74dd9fd",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
    "414051c5-a21c-413a-ab21-de78bc60b661/Option_2": {
      "en": "Decline",
      "cn": "拒绝\n",
      "ru": "Снижение",
      "status": "machine",
      "srcHash": "b45ff6135deb1972",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
    "3b9ff894-26b4-4866-a06d-7b8aee4aadd2/EventContent": {
      "en": "\"Well, have you heard about this matter...\"",
      "cn": "“如此这般，阁下可曾听说此事……”",
      "ru": "\"Ну, вы слышали об этом деле...\"",
      "status": "machine",
      "srcHash": "cfd44203c6aa0c39",
