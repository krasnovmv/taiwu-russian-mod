    "414051c5-a21c-413a-ab21-de78bc60b661/EventContent": {
      "en": "You're underestimating me. That's not enough. However, if there are more...",
      "cn": "区区此等物件，莫不是小瞧了在下。不过若有其他珍宝……",
      "ru": "Ты недооцениваешь меня. Этого недостаточно. Однако, если их будет больше...",
      "status": "machine",
      "srcHash": "74dc2e0a15a15154",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "414051c5-a21c-413a-ab21-de78bc60b661/Option_1": {
      "en": "How about this?",
      "cn": "此物如何？",
      "ru": "Как насчет этого?",
      "status": "machine",
      "srcHash": "113f8a0588b2c10e",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "414051c5-a21c-413a-ab21-de78bc60b661/Option_2": {
      "en": "Decline",
      "cn": "拒绝\n",
      "ru": "Снижение",
      "status": "machine",
      "srcHash": "20e99add4094434c",
