    "c9d36980-0a4b-49e8-929b-3ad461da0051/EventContent": {
      "en": "\"Watch your step unless you want trouble.\"",
      "cn": "“你观你行走江湖亦需小心……”",
      "ru": "- Смотри под ноги, если не хочешь неприятностей.",
      "status": "machine",
      "srcHash": "96c35ea9aa019946",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
