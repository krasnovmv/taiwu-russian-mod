    "b314ec8f-7d6c-4959-a2e1-7b7d76291cb2/EventContent": {
      "en": "\"I am not one to succumb to such temptations.\"",
      "cn": "“不可，我非贪婪之人……”",
      "ru": "- Я не из тех, кто поддается подобным искушениям.",
      "status": "machine",
      "srcHash": "5badb5205eb24105",
      "engine": "yandex",
