      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "3b9ff894-26b4-4866-a06d-7b8aee4aadd2/EventContent": {
      "en": "\"Well, have you heard about this matter...\"",
      "cn": "“如此这般，阁下可曾听说此事……”",
      "ru": "\"Ну, вы слышали об этом деле...\"",
      "status": "machine",
      "srcHash": "51e874a20b8ca88c",
