    "398578ca-8f71-4299-8b65-b4aa73716845/EventContent": {
      "en": "\"Yeah, that person's cricket is definitely stronger...\"",
      "cn": null,
      "ru": "\"Да, Сверчок этого человека определенно сильнее...\"",
      "status": "machine",
