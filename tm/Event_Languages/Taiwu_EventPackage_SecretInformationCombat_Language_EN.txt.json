      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "63a131da-af63-41ac-bdeb-b501683c8ec3/EventContent": {
      "en": "\"Are you trying to humiliate me?!\"",
      "cn": null,
      "ru": "- Ты пытаешься унизить меня?!",
      "status": "machine",
      "srcHash": "d5bde5dd69f8e3ee",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "63e4ea76-8908-4c82-9f09-fb3614e37a66/EventContent": {
      "en": "\"Fine, that way no one can look down on me...\"",
      "cn": null,
      "ru": "\"Прекрасно, тогда никто не сможет смотреть на меня свысока...\"",
      "status": "machine",
      "srcHash": "049148021997ee32",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "63e4ea76-8908-4c82-9f09-fb3614e37a66/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "64e1d7c9-e302-4e17-9106-0e6e028381f2/EventContent": {
      "en": "\"Too bad I didn't get to see their embarrassing moment in person...\"",
      "cn": null,
      "ru": "\"Жаль, что мне не удалось увидеть их неловкий момент лично...\"",
      "status": "machine",
      "srcHash": "7df5446462fc9309",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "64e1d7c9-e302-4e17-9106-0e6e028381f2/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "6d4b9168-7ee9-4863-b807-22073f22ca44/EventContent": {
      "en": "\"I thought they were unbeatable. What a shame...\"",
      "cn": null,
      "ru": "\"Я думал, что они непобедимы. Какой позор...\"",
      "status": "machine",
      "srcHash": "712dc232f16e5bdb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "6d4b9168-7ee9-4863-b807-22073f22ca44/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7174f203-8b41-4a43-9800-7c4c4873c987/EventContent": {
      "en": "\"Only when you let go of winning and losing can you truly gain something...\"",
      "cn": null,
      "ru": "\"Только когда вы перестанете выигрывать и проигрывать, вы сможете по-настоящему чего-то добиться...\"",
      "status": "machine",
      "srcHash": "c81afdddd3c5fe56",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7174f203-8b41-4a43-9800-7c4c4873c987/Option_1": {
      "en": "(...)",
      "cn": null,
      "ru": "(...)",
      "status": "machine",
      "srcHash": "3ed8e8d8dc7ad7bb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7de5dcfa-7d2c-442c-93fc-e92b86aeef85/EventContent": {
      "en": "\"Win or lose, it's all part of the game...\"",
      "cn": null,
      "ru": "\"Выиграешь или проиграешь, все это часть игры...\"",
      "status": "machine",
      "srcHash": "78860a0461508e09",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7de5dcfa-7d2c-442c-93fc-e92b86aeef85/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7ed151e6-e503-4147-b386-1a96b5a83b90/EventContent": {
      "en": "\"Let's not ruin the mood over this...\"",
      "cn": null,
      "ru": "- Давай не будем портить настроение из-за этого...",
      "status": "machine",
      "srcHash": "00b03741505540e4",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7fa56630-a4e7-4d0f-be0e-818f99b35678/EventContent": {
      "en": "\"Not everything in life needs a winner and a loser...\"",
      "cn": null,
      "ru": "\"Не для всего в жизни нужны победитель и проигравший...\"",
      "status": "machine",
      "srcHash": "fe790af394fc9a20",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7fa56630-a4e7-4d0f-be0e-818f99b35678/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8185a2e3-051f-4136-a3c3-ec9f83efd949/EventContent": {
      "en": "\"It's just a casual match. No need to take it too seriously...\"",
      "cn": null,
      "ru": "\"Это просто случайный матч. Не нужно воспринимать это слишком серьезно...\"",
      "status": "machine",
      "srcHash": "d8e984445202eab2",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8185a2e3-051f-4136-a3c3-ec9f83efd949/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "84fb8986-4904-4538-ad86-a413a3639739/EventContent": {
      "en": "nan",
      "cn": null,
      "ru": "бабушка",
      "status": "machine",
      "srcHash": "9f3c43bb86543291",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "882c8b70-79be-402b-8224-9def73762d91/EventContent": {
      "en": "\"Even so, I can't afford to slack off...\"",
      "cn": null,
      "ru": "\"Даже если так, я не могу позволить себе расслабляться...\"",
      "status": "machine",
      "srcHash": "fe001bddf6041373",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "882c8b70-79be-402b-8224-9def73762d91/Option_1": {
      "en": "(...)",
      "cn": null,
      "ru": "(...)",
      "status": "machine",
      "srcHash": "3ed8e8d8dc7ad7bb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8cde938c-f92c-434f-bb68-64f83e90cb41/EventContent": {
      "en": "\"Ahh, I guess I didn't raise my cricket well enough...\"",
      "cn": null,
      "ru": "\"Ах, наверное, я недостаточно хорошо воспитал своего Сверчка...\"",
      "status": "machine",
      "srcHash": "f8314801d26edf8d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8cde938c-f92c-434f-bb68-64f83e90cb41/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8eb5e423-dc80-40fd-bf3b-d5c64c66f1aa/EventContent": {
      "en": "\"Poor crickets, trapped in this person's hands with no freedom...\"",
      "cn": null,
      "ru": "\"Бедные Сверчки, попавшие в ловушку в руках этого человека без всякой свободы...\"",
      "status": "machine",
      "srcHash": "3bcdbee682114b7b",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "8eb5e423-dc80-40fd-bf3b-d5c64c66f1aa/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "9080af3c-c3c3-4cd1-a3a0-bb04ab9749f4/EventContent": {
      "en": "\"A man of honor keeps his word and accepts loss with grace...\"",
      "cn": null,
      "ru": "\"Человек чести держит свое слово и с достоинством принимает потери...\"",
      "status": "machine",
      "srcHash": "093178006f1f9d94",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "9080af3c-c3c3-4cd1-a3a0-bb04ab9749f4/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "94b447a0-0a3d-4666-923c-6a67a19e1cdc/EventContent": {
      "en": "\"I won...\"",
      "cn": null,
      "ru": "\"Я выиграл...\"",
      "status": "machine",
      "srcHash": "59e99714b0f02257",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "94b447a0-0a3d-4666-923c-6a67a19e1cdc/Option_1": {
      "en": "(...)",
      "cn": null,
      "ru": "(...)",
      "status": "machine",
      "srcHash": "3ed8e8d8dc7ad7bb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "9b5f737b-c436-4f2f-b11f-65d9d2853f8d/EventContent": {
      "en": "\"This person does have some good qualities... too bad they've got no morals.\"",
      "cn": null,
      "ru": "\"У этого человека действительно есть несколько хороших качеств... жаль, что у них нет морали.\"",
      "status": "machine",
      "srcHash": "5d1ee4cc2428ab2a",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "9b5f737b-c436-4f2f-b11f-65d9d2853f8d/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a54b716d-143a-44f8-8028-34e634d7275e/EventContent": {
      "en": "\"I still have plenty of tricks I haven't used yet...\"",
      "cn": null,
      "ru": "\"У меня все еще есть много трюков, которые я еще не использовал...\"",
      "status": "machine",
      "srcHash": "fb4493ef26a01d00",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a54b716d-143a-44f8-8028-34e634d7275e/Option_1": {
      "en": "(...)",
      "cn": null,
      "ru": "(...)",
      "status": "machine",
      "srcHash": "3ed8e8d8dc7ad7bb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a7eccc8b-1de8-4c7a-a27d-7ad6d630e3c7/EventContent": {
      "en": "\"I learned a lot from this match too...\"",
      "cn": null,
      "ru": "\"Я тоже многому научился в этом матче...\"",
      "status": "machine",
      "srcHash": "e85bc6fd183939a5",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a8704a08-c890-433b-bff5-7f009f798e8e/EventContent": {
      "en": "\"Went easy on [them], that's all...\"",
      "cn": null,
      "ru": "\"Был помягче с [ними], вот и все...\"",
      "status": "machine",
      "srcHash": "2efe3c098476f10d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a8704a08-c890-433b-bff5-7f009f798e8e/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b205a370-b84e-4f61-b698-59d48dc16b6e/EventContent": {
      "en": "\"There's no way I'm missing out on such a good show!\"",
      "cn": null,
      "ru": "\"Я ни за что не пропущу такое хорошее шоу!\"",
      "status": "machine",
      "srcHash": "af9b9e6a02416dfe",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b205a370-b84e-4f61-b698-59d48dc16b6e/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b27bb835-6213-4722-8019-845c78d619ba/EventContent": {
      "en": "nan",
      "cn": null,
      "ru": "бабушка",
      "status": "machine",
      "srcHash": "9f3c43bb86543291",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b4e7927a-7cce-497d-8ad1-935148061755/EventContent": {
      "en": "\"Fall behind? Then catch up...\"",
      "cn": null,
      "ru": "\"Отстать? Потом догнать...\"",
      "status": "machine",
      "srcHash": "f6cf5ebd823709b7",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b4e7927a-7cce-497d-8ad1-935148061755/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b7392263-0850-411e-a868-fe3636a25754/EventContent": {
      "en": "\"Now that it's over, they really need to rest up...\"",
      "cn": null,
      "ru": "\"Теперь, когда все закончилось, им действительно нужно отдохнуть...\"",
      "status": "machine",
      "srcHash": "49cd468cf7b545da",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b7392263-0850-411e-a868-fe3636a25754/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b800d0ba-4c82-4b2c-bd91-90ff09ddd3e7/EventContent": {
      "en": "\"Crickets may love to fight, but people shouldn't be the same...\"",
      "cn": null,
      "ru": "\"Сверчки, может, и любят подраться, но люди не должны быть одинаковыми...\"",
      "status": "machine",
      "srcHash": "a036b95ece95815f",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b9d5522d-ef48-442e-a48b-06a69eddcbef/EventContent": {
      "en": "\"Winning or losing doesn't matter, as long as we learn from each other...\"",
      "cn": null,
      "ru": "\"Победа или поражение не имеет значения, пока мы учимся друг у друга...\"",
      "status": "machine",
      "srcHash": "60907d9563b47c91",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "b9d5522d-ef48-442e-a48b-06a69eddcbef/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "ba629fae-fab2-4c04-9987-9ccc57ce26fa/EventContent": {
      "en": "\"Useless. As I suspected...\"",
      "cn": null,
      "ru": "- Бесполезно. Как я и подозревал...",
      "status": "machine",
      "srcHash": "f3b787d7449b2502",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "ba629fae-fab2-4c04-9987-9ccc57ce26fa/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "bc1cb9a1-e6a1-4f7a-a87d-7fc1267f3e02/EventContent": {
      "en": "\"Back to challenge me again? So, what's the wager this time?\"",
      "cn": null,
      "ru": "- Вернулся, чтобы снова бросить мне вызов? Итак, какое пари на этот раз?\"",
      "status": "machine",
      "srcHash": "02e7003bdb7e68a9",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "bc9a0138-043e-4b69-a091-2bd7acebea67/EventContent": {
      "en": "\"Yeah, your cricket really is the better one...\"",
      "cn": null,
      "ru": "\"Да, твой Сверчок действительно лучше...\"",
      "status": "machine",
      "srcHash": "f15d4784305610b5",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "bc9a0138-043e-4b69-a091-2bd7acebea67/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "c5c433bd-353f-476a-8ce6-37b8da76d5cf/EventContent": {
      "en": "\"Here for more? The fun's just beginning...\"",
      "cn": null,
      "ru": "- Пришел за добавкой? Веселье только начинается...\"",
      "status": "machine",
      "srcHash": "688645237a6b0cc9",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "c854017e-6c9d-407c-9463-383f067d4a3e/EventContent": {
      "en": "\"Shameless evildoer! On your guard!\"",
      "cn": null,
      "ru": "- Бесстыдный злодей! Будь настороже!",
      "status": "machine",
      "srcHash": "709b39e4640417dd",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "c854017e-6c9d-407c-9463-383f067d4a3e/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "970cf94b4f720df8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "c8c46288-b3e0-4a21-addf-21278d3ba54b/EventContent": {
      "en": "\"Gotta find a way to knock this person down a peg...\"",
      "cn": null,
      "ru": "\"Нужно найти способ сбить с толку этого человека...\"",
      "status": "machine",
      "srcHash": "ae87e8063d9100de",
      "engine": "yandex",
