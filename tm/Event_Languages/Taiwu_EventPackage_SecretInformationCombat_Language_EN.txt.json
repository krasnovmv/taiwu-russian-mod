    },
    "39869f47-a868-4391-9a34-9380ac5a61a6/EventContent": {
      "en": "\"Hmph, you think too much of yourself, overestimating your abilities...\"",
      "cn": null,
      "ru": "\"Хм, ты слишком много о себе думаешь, переоцениваешь свои способности...\"",
      "status": "machine",
      "srcHash": "722fefe14d43d8d1",
