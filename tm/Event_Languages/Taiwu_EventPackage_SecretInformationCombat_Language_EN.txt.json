    "cadc921c-2268-46ad-a3e5-4f194df4b359/EventContent": {
      "en": "\"Now this is gonna be fun to watch...\"",
      "cn": null,
      "ru": "\"Вот это будет забавно наблюдать...\"",
      "status": "machine",
      "srcHash": "b3471ea3ac1cc739",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "cadc921c-2268-46ad-a3e5-4f194df4b359/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
