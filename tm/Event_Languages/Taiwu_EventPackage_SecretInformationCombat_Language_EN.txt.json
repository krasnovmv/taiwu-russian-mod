    "34e364be-381b-4092-853f-45c254037688/EventContent": {
      "en": "\"These matches are boring. Let's play something else...\"",
      "cn": null,
      "ru": "\"Эти матчи скучные. Давай сыграем во что-нибудь другое...\"",
      "status": "machine",
