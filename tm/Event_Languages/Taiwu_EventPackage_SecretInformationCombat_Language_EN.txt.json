      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cbc4918e-e11f-4c98-9083-4b1db060ca8d/EventContent": {
      "en": "\"I admit, I still have a lot to improve on...\"",
      "cn": null,
      "ru": "\"Я признаю, что мне еще многое предстоит улучшить...\"",
      "status": "machine",
      "srcHash": "8a989e60d596df67",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cbc4918e-e11f-4c98-9083-4b1db060ca8d/Option_1": {
      "en": "(...)",
      "cn": null,
      "ru": "(...)",
      "status": "machine",
      "srcHash": "7631476d20651b6a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cc788e12-c5cf-469f-9706-93a3a2980cac/EventContent": {
      "en": "\"Ha! Didn't see that coming... pretty interesting!\"",
      "cn": null,
      "ru": "- Ха! Я этого не предвидел... довольно интересно!\"",
      "status": "machine",
      "srcHash": "fb96403fdd6d75e0",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cc788e12-c5cf-469f-9706-93a3a2980cac/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ccc5657d-f80b-4c59-979a-c4bfebfd80f8/EventContent": {
      "en": "\"Winning doesn't matter. Just don't let the cricket get hurt...\"",
      "cn": null,
      "ru": "\"Победа не имеет значения. Только не дай Сверчку пострадать...\"",
      "status": "machine",
      "srcHash": "e2f692d4c7b77484",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ccc5657d-f80b-4c59-979a-c4bfebfd80f8/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cd56b8d6-8e6e-4f0c-bb9a-ac8c3abf7924/EventContent": {
      "en": "\"Lost in revelry, no wonder they can't tell right from wrong...\"",
      "cn": null,
      "ru": "\"Потерявшись в веселье, неудивительно, что они не могут отличить добро от зла...\"",
      "status": "machine",
      "srcHash": "f450e96957c0e42a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "cd56b8d6-8e6e-4f0c-bb9a-ac8c3abf7924/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "d04ab869-4e0a-4a59-8636-ed4b692f28b9/EventContent": {
      "en": "\"Yeah, it's like sailing upstream: you either advance, or you're carried backward...\"",
      "cn": null,
      "ru": "\"Да, это как плыть против течения: ты либо продвигаешься вперед, либо тебя несет назад...\"",
      "status": "machine",
      "srcHash": "642c3592f4f70b0b",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "d04ab869-4e0a-4a59-8636-ed4b692f28b9/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "d9e508a1-7a8c-46bd-ae81-1bac9477b3b1/EventContent": {
      "en": "\"They must've pulled some sneaky trick...\"",
      "cn": null,
      "ru": "\"Должно быть, они провернули какой-то подлый трюк...\"",
      "status": "machine",
      "srcHash": "f2292579ca2eb813",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "d9e508a1-7a8c-46bd-ae81-1bac9477b3b1/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "dedb8e56-8e3d-4f86-bba2-65359b667274/EventContent": {
      "en": "\"Win or lose, as long as we had fun.\"",
      "cn": null,
      "ru": "- Выиграем мы или проиграем, главное, чтобы нам было весело.",
      "status": "machine",
      "srcHash": "c9f4e6160005b08e",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "dedb8e56-8e3d-4f86-bba2-65359b667274/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e325171b-122b-4749-a69c-cf19ddb2180a/EventContent": {
      "en": "\"A loser still refusing to admit defeat?\"",
      "cn": null,
      "ru": "- Неудачник, все еще отказывающийся признать поражение?",
      "status": "machine",
      "srcHash": "dee63aadb6c1884f",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e327d761-9937-476a-9894-576454998ecf/EventContent": {
      "en": "\"Fine, that way no one can look down on me...\"",
      "cn": null,
      "ru": "\"Прекрасно, тогда никто не сможет смотреть на меня свысока...\"",
      "status": "machine",
      "srcHash": "f3ecdc77f0a6d284",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e327d761-9937-476a-9894-576454998ecf/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e4a1f27b-22ab-4931-8ac0-a6ecf6e4d55b/EventContent": {
      "en": "\"Alright, you won this time...\"",
      "cn": null,
      "ru": "\"Хорошо, на этот раз ты победил...\"",
      "status": "machine",
      "srcHash": "dfc2bf8b89bb0aaf",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e7725c71-73c5-4af6-89ac-540dc3f2b8c5/EventContent": {
      "en": "\"We fought fair and square. There's a winner now...\"",
      "cn": null,
      "ru": "\"Мы сражались честно. Теперь есть победитель...\"",
      "status": "machine",
      "srcHash": "5d171fb98c974712",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e7725c71-73c5-4af6-89ac-540dc3f2b8c5/Option_1": {
      "en": "(Agree to it...)",
      "cn": null,
      "ru": "(Согласитесь с этим...)",
      "status": "machine",
      "srcHash": "b4c77bc9d18135f1",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e7725c71-73c5-4af6-89ac-540dc3f2b8c5/Option_2": {
      "en": "(Taunt them...)",
      "cn": null,
      "ru": "(Насмехайся над ними...)",
      "status": "machine",
      "srcHash": "ad6d89a7596e8e99",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e7725c71-73c5-4af6-89ac-540dc3f2b8c5/Option_3": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e78cb667-7a0b-426d-82a1-2a31be9a5520/EventContent": {
      "en": "\"Push too hard and you'll break. Best not to fight too much...\"",
      "cn": null,
      "ru": "- Надави слишком сильно, и ты сломаешься. Лучше не ссориться слишком сильно...\"",
      "status": "machine",
      "srcHash": "04635b9ead93f2e0",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e78cb667-7a0b-426d-82a1-2a31be9a5520/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e85c7c6e-ada9-414f-81be-190bf21a284a/EventContent": {
      "en": "\"It's easy to defeat others, but hard to conquer yourself...\"",
      "cn": null,
      "ru": "\"Легко победить других, но трудно победить самого себя...\"",
      "status": "machine",
      "srcHash": "21e8778891784eb7",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e85c7c6e-ada9-414f-81be-190bf21a284a/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "e9cef608-7b70-4b6f-ac70-18fd6396b87c/EventContent": {
      "en": "\"Let's not ruin the mood over this...\"",
      "cn": null,
      "ru": "- Давай не будем портить настроение из-за этого...",
      "status": "machine",
      "srcHash": "c302eb852b486fd3",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ecc215aa-1ac6-4a11-bcac-4dd3c971a0ac/EventContent": {
      "en": "\"A loser still refusing to admit defeat?\"",
      "cn": null,
      "ru": "- Неудачник, все еще отказывающийся признать поражение?",
      "status": "machine",
      "srcHash": "dee63aadb6c1884f",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ed39a6c7-8bac-4277-9e2c-0ba2194ae4e9/EventContent": {
      "en": "\"Not everything in life needs a winner and a loser...\"",
      "cn": null,
      "ru": "\"Не для всего в жизни нужны победитель и проигравший...\"",
      "status": "machine",
      "srcHash": "66b3ba38580cf4ca",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ed39a6c7-8bac-4277-9e2c-0ba2194ae4e9/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ee285d38-66e9-4df5-a5e5-34ab3524d1fe/EventContent": {
      "en": "\"One loss doesn't mean anything long-term...\"",
      "cn": null,
      "ru": "\"Одна потеря ничего не значит в долгосрочной перспективе...\"",
      "status": "machine",
      "srcHash": "da9907bac4026f23",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ee285d38-66e9-4df5-a5e5-34ab3524d1fe/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ef68ddcf-82d6-41e7-8b19-219a0208bf9b/EventContent": {
      "en": "\"What, you're not gonna admit you lost?\"",
      "cn": null,
      "ru": "- Что, ты не собираешься признать, что проиграл?",
      "status": "machine",
      "srcHash": "d3d949f81c18492a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f0c4c0d1-6776-4088-b4c7-10ca2703cef1/EventContent": {
      "en": "\"They brought this on themselves. Serves them right...\"",
      "cn": null,
      "ru": "\"Они сами навлекли это на себя. Так им и надо...\"",
      "status": "machine",
      "srcHash": "da92cd99f9ba1b17",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f0c4c0d1-6776-4088-b4c7-10ca2703cef1/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f1282f3b-5ff0-43d9-a452-41cd28552321/EventContent": {
      "en": "\"Win or lose, it's not worth stressing over...\"",
      "cn": null,
      "ru": "\"Выиграешь или проиграешь, не стоит из-за этого переживать...\"",
      "status": "machine",
      "srcHash": "c5305d745259ca40",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f22d3c4f-d67f-42c4-a5e6-72dec1113490/EventContent": {
      "en": "\"Always chasing fights isn't the right path...\"",
      "cn": null,
      "ru": "\"Всегда гоняться за драками - неправильный путь...\"",
      "status": "machine",
      "srcHash": "0eaedd25a76001c6",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f22d3c4f-d67f-42c4-a5e6-72dec1113490/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f339f6aa-36ff-4cb5-8fc4-8d1c875bc5b2/EventContent": {
      "en": "\"After this setback, I wonder if they'll finally wake up...\"",
      "cn": null,
      "ru": "\"Интересно, проснутся ли они наконец после этой неудачи...\"",
      "status": "machine",
      "srcHash": "0ea7914ed4e39f47",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f339f6aa-36ff-4cb5-8fc4-8d1c875bc5b2/Option_1": {
      "en": "(Other topics...)",
      "cn": null,
      "ru": "(Другие темы...)",
      "status": "machine",
      "srcHash": "f7d5772ebbcdb00d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "f932436b-7975-437c-b057-fb3276d6a16f/EventContent": {
      "en": "\"No way, that doesn't count! You cheated!\"",
      "cn": null,
      "ru": "- Ни за что, это не считается! Ты жульничал!\"",
      "status": "machine",
      "srcHash": "e9bc70fe8e5703d3",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ff233695-71a6-4895-a1db-583cb36eef82/EventContent": {
      "en": "\"Let's not ruin the mood over this...\"",
      "cn": null,
      "ru": "- Давай не будем портить настроение из-за этого...",
      "status": "machine",
      "srcHash": "c302eb852b486fd3",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "ffa6d7a7-9801-4a23-9e12-330b915393cb/EventContent": {
      "en": "\"That was a fair match. The result's clear...\"",
      "cn": null,
      "ru": "- Это был честный поединок. Результат очевиден...\"",
      "status": "machine",
      "srcHash": "478c1ac594c6842b",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    }
  }
