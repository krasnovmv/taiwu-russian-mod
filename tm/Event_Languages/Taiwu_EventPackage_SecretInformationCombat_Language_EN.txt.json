    "474dd8d5-13cf-4f84-9e50-289b47fb1a02/EventContent": {
      "en": "\"Nothing in life is certain. Winning or losing is just temporary...\"",
      "cn": null,
      "ru": "- В жизни ни в чем нельзя быть уверенным. Победа или поражение - это всего лишь временное явление...\"",
      "status": "machine",
      "srcHash": "b8947f65a4bc35b0",
      "engine": "yandex",
