      "updatedAt": "2026-06-21T21:21:05.664Z"
    },
    "dfd6c986-833f-4063-a165-0d4bcf770402/Option_2": {
      "en": "(Staying here for now...)",
      "cn": "（暂留此地……）\n",
      "ru": "(Пока остаюсь здесь...)",
      "status": "machine",
      "srcHash": "d78c2f7e1a6deebb",
