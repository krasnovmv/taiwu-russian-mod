    "dfd6c986-833f-4063-a165-0d4bcf770402/EventContent": {
      "en": "The enemy is still on the Offense,<NL>Do you want to leave this place……",
      "cn": "敌军仍在进攻，<NL>是否离开此地……",
      "ru": "Враг все еще нападает,<NL>Ты хочешь покинуть это место……",
      "status": "machine",
      "srcHash": "5dafc0cbca3ff181",
      "engine": "yandex",
      "updatedAt": "2026-06-21T21:21:05.664Z"
    },
    "dfd6c986-833f-4063-a165-0d4bcf770402/Option_1": {
      "en": "(Leave this place...)",
      "cn": "（离开此地……）",
      "ru": "(Покинь это место...)",
      "status": "machine",
      "srcHash": "0efd75cd9616ee0e",
