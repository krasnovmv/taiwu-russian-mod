    "2020f0b7-8184-4a05-b9cf-fe1f580a654c/Option_1": {
      "en": "(Switch the item in hand to \"Poultry Dish\"...)",
      "cn": null,
      "ru": "(Переключите блюдо, которое вы держите в руке, на \"Блюдо из птицы\"...)",
