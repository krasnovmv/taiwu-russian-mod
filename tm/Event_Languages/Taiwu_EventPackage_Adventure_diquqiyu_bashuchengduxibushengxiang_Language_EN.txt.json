    "7d9f4d7d-78fc-4363-98d4-f367fdb5adc6/EventContent": {
      "en": "Beast Dish is placed here.<NL>Fatty jade glows against amber, slow-cooked over pinewood fragrance...",
      "cn": null,
      "ru": "Здесь помещено блюдо из мяса зверя.<NL>Жирный Нефрит переливается на фоне янтаря, приготовленный на медленном огне с ароматом соснового дерева...",
      "status": "machine",
      "srcHash": "1b68f1ae0abfae51",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
