    "70e0984e-9522-45ec-9622-65fe6788c13e/EventContent": {
      "en": "\"Oops, sorry about that... I didn't mean to bump into you!\"<NL>Your things drop...",
      "cn": null,
      "ru": "\"Упс, извини за это... Я не хотел на тебя наткнуться!\"<NL>Твои вещи падают...",
      "status": "machine",
      "srcHash": "46691c1b2ac2329b",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
    "70e0984e-9522-45ec-9622-65fe6788c13e/Option_1": {
