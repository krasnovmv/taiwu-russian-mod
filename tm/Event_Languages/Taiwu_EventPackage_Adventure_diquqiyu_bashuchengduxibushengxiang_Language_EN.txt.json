    },
    "4726c6e5-2150-485e-8f9a-eb02975e06a0/EventContent": {
      "en": "Congratulations on completing tasks. I've prepared generous rewards for you. They are on the way!",
      "cn": null,
      "ru": "Поздравляю с выполнением заданий. Я приготовил для тебя щедрое вознаграждение. Они уже в пути!",
      "status": "machine",
      "srcHash": "cac0980f26ca21a7",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:18:49.896Z"
    },
