    },
    "2f452595-791b-4420-874d-540751f0f84b/EventContent": {
      "en": "<Character key=RoleTaiwu str=Name /> follows the trail to its end and finds a <Character key=RoleBeast str=Name/> caught fast in a trap deep in the thick woods, struggling to break free...",
      "cn": null,
      "ru": "<Character key=RoleTaiwu str=Name /> проследует по следу до его конца и найдет... <Character key=RoleBeast str=Name/> попавший в ловушку глубоко в густом лесу, изо всех сил пытающийся вырваться на свободу...",
      "status": "machine",
      "srcHash": "9015b11b4fe29fdc",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
