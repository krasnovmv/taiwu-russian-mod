    "10d9668a-cb9e-4e0c-8617-57793e68979f/EventContent": {
      "en": "\"Knowing both oneself and the enemy is beneficial after all...\"",
      "cn": null,
      "ru": "\"В конце концов, знать и себя, и врага полезно...\"",
      "status": "machine",
      "srcHash": "adf7a5aec3c0c9de",
      "engine": "yandex",
      "updatedAt": "2026-06-29T10:20:21.054Z"
