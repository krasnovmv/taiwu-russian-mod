    "04a4aa90-5134-460c-bf9d-1ab6c70ba14b/EventContent": {
      "en": "\"Well, that's definitely something worth celebrating...\"",
      "cn": null,
      "ru": "- Что ж, это определенно стоит отпраздновать...",
