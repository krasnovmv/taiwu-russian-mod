    },
    "1da35402-7740-47b9-8909-52772e5636d7/EventContent": {
      "en": "\"Maybe I should try my luck...\"",
      "cn": null,
      "ru": "\"Может быть, мне стоит попытать счастья...\"",
      "status": "machine",
      "srcHash": "b41689c2ae40f3f3",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "1da35402-7740-47b9-8909-52772e5636d7/Option_1": {
