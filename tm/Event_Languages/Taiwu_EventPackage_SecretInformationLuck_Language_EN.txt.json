    "18dff9ff-b82d-48c4-a37d-9dd6911e2072/EventContent": {
      "en": "\"What a show. That was actually hilarious...\"",
      "cn": null,
      "ru": "\"Что за шоу. Это было на самом деле весело...\"",
      "status": "machine",
      "srcHash": "9350d834be368851",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
