    "f45f7d08-b5a6-437a-b44f-f59e493975eb/EventContent": {
      "en": "\"I've been looking forward to meeting you for a long time!\"<NL><NL><color=#lightgrey>(Meet up with <Character key=CharacterId str=Name /> as arranged...)</color>",
      "cn": "“我已盼望与你见面多时了！”<NL><NL><color=#lightgrey>（如约与<Character key=CharacterId str=Name />见面……）</color>",
      "ru": "\"Я с нетерпением ждал встречи с вами в течение долгого времени!\"<NL><NL><color=#lightgrey>(Встретимся с <Character key=CharacterId str=Name /> как договорились...)</color>",
      "status": "machine",
      "srcHash": "33d359179881e302",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "f45f7d08-b5a6-437a-b44f-f59e493975eb/Option_1": {
      "en": "(Meet as arranged...)",
      "cn": "（如约而至……）\n",
      "ru": "(Встретимся, как договорились...)",
      "status": "machine",
      "srcHash": "4ca93628da1a7cdd",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a66c22f6-1d88-4711-aed5-054255d46e72/EventContent": {
      "en": "\"You... why do you look like this!?\"<NL><NL><color=#lightgrey>(<Character key=CharacterId str=Name/> saw <Character key=RoleTaiwu str=Name/> being disheveled, unwilling to talk to <Character key=RoleTaiwu str=Name/>...)</color>",
      "cn": "“你……你……何以这般模样！？”<NL><NL><color=#lightgrey>（<Character key=CharacterId str=Name/>见<Character key=RoleTaiwu str=Name/>衣不蔽体，不愿与<Character key=RoleTaiwu str=Name/>说话……）</color>",
      "ru": "- Ты... почему у тебя такой вид?!<NL><NL><color=#lightgrey>(<Character key=CharacterId str=Name/> увидел <Character key=RoleTaiwu str=Name/> был взъерошен, не желал разговаривать с <Character key=RoleTaiwu str=Name/>...)</color>",
      "status": "machine",
      "srcHash": "8f28b5dad338ece7",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "a66c22f6-1d88-4711-aed5-054255d46e72/Option_1": {
      "en": "(Take leave...)",
      "cn": "（道别……）\n",
      "ru": "(Прощаюсь...)",
      "status": "machine",
      "srcHash": "6fe395466a683d6a",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "629311a9-de4e-4189-81b3-cc837948c2ce/EventContent": {
      "en": "nan",
      "cn": "\n",
      "ru": "бабушка",
      "status": "machine",
      "srcHash": "9f3c43bb86543291",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "dc4047f7-f266-4d2f-a2e1-37694c3c3247/EventContent": {
      "en": "\"Just wait for my good news.\"",
      "cn": "“你便等我的……好消息吧……”",
      "ru": "- Просто жди от меня хороших новостей.",
      "status": "machine",
      "srcHash": "c00b782db7e2e84c",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "dc4047f7-f266-4d2f-a2e1-37694c3c3247/Option_1": {
      "en": "(Feeling both joy and worry...)",
      "cn": "（亦喜亦忧……）\n",
      "ru": "(Испытывая одновременно радость и беспокойство...)",
      "status": "machine",
      "srcHash": "0bf046f95e2de5a5",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7c63411f-5928-4dc0-b1f5-afe0ba16fcfa/EventContent": {
      "en": "\"Have you been waiting long? Sorry for the delay!\"<NL><NL><color=#lightgrey>(Meet up with <Character key=CharacterId str=Name /> as arranged...)</color>",
      "cn": "“已等候了许久吗？真是抱歉！”<NL><NL><color=#lightgrey>（如约与<Character key=CharacterId str=Name />见面……）</color>",
      "ru": "\"Долго ждали? Извините за задержку!\"<NL><NL><color=#lightgrey>(Встретимся с <Character key=CharacterId str=Name /> как договорились...)</color>",
      "status": "machine",
      "srcHash": "8820bf77fc0d39d8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "7c63411f-5928-4dc0-b1f5-afe0ba16fcfa/Option_1": {
      "en": "(Meet as arranged...)",
      "cn": "（如约而至……）\n",
      "ru": "(Встретимся, как договорились...)",
      "status": "machine",
      "srcHash": "4ca93628da1a7cdd",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "929db66a-ffda-4d34-ac04-2ec4e40403c3/EventContent": {
      "en": "\"If you hadn't shown up, I might have left!\"<NL><NL><color=#lightgrey>(Meet up with <Character key=CharacterId str=Name /> as arranged...)</color>",
      "cn": "“你若再不出现，我可就要走啦！”<NL><NL><color=#lightgrey>（如约与<Character key=CharacterId str=Name />见面……）</color>",
      "ru": "\"Если бы ты не появился, я бы, возможно, ушел!\"<NL><NL><color=#lightgrey>(Встретимся с <Character key=CharacterId str=Name /> как договорились...)</color>",
