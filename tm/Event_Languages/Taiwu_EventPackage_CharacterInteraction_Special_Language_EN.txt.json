    "0f6a8d46-c065-4d8d-b4cc-2a85be694bd8/Option_1": {
      "en": "(Take the lost baby with you...)",
      "cn": "（救助落单的婴孩至同道行列……）",
      "ru": "(Возьми с собой потерянного ребенка...)",
      "status": "machine",
      "srcHash": "0dd8ab10df4c1bd0",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
