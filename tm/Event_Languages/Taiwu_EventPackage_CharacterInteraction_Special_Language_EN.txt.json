    },
    "0f6a8d46-c065-4d8d-b4cc-2a85be694bd8/EventContent": {
      "en": "\"Ah... goo... gaa...\"",
      "cn": "“呀……吧……吧……呀……”",
      "ru": "\"Ах... гу... гаа...\"",
      "status": "machine",
      "srcHash": "9f82c4d1fcee6b3e",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
