    "0f6a8d46-c065-4d8d-b4cc-2a85be694bd8/Option_2": {
      "en": "(Unable to comprehend the baby's babble...)",
      "cn": "（不明白婴孩说的话语……）\n",
      "ru": "(Не в силах понять детский лепет...)",
