      "en": "Defeat an opponent whose Pure Essence is 3 levels (or more) lower than yours.",
      "cn": "在自己的精纯境界比对手高3或以上的情况下击败对手。",
      "ru": "Победите противника, чья чистая эссенция на 3 уровня (или более) ниже вашей.",
      "status": "machine",
      "srcHash": "554f2c8d4abdec0b",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_15": {
      "en": "Defeat a pregnant opponent.",
      "cn": "击败身怀六甲的对手。",
      "ru": "Победите беременную соперницу.",
      "status": "machine",
      "srcHash": "d575c64370e35206",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "Desc_16": {
      "en": "Defeat opponents who outnumber you.",
      "cn": "在我方人数比敌方人数少的情况下战胜对手。",
      "ru": "Побеждайте противников, которые превосходят вас численностью.",
      "status": "machine",
      "srcHash": "bd48924e54e69c7c",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "Desc_17": {
      "en": "Defeat an older opponent while you are underage.",
      "cn": "在尚未成年且对方比自己年长的情况下击败对手。",
      "ru": "Победите старшего противника, будучи несовершеннолетним.",
      "status": "machine",
      "srcHash": "56e1af853d3395b7",
      "engine": "yandex",
      "updatedAt": "2026-07-13T18:56:48.037Z"
    },
    "Desc_18": {
      "en": "Defeat an opponent whose equipment is overall stronger than yours.",
      "cn": "击败装备整体比自己强的对手。",
      "ru": "Победите противника, чье снаряжение в целом сильнее вашего.",
      "status": "machine",
      "srcHash": "31cad1758afd80c0",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_19": {
      "en": "Defeat an opponent whose True Qi is much higher than yours.",
      "cn": "击败真气比自己高很多的对手。",
      "ru": "Победите противника, истинная ци которого намного выше вашей.",
      "status": "machine",
      "srcHash": "5f44f0fb798b2014",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_20": {
      "en": "Defeat an opponent who uses a more advanced Martial Art than yours.",
      "cn": "仅用了相较对手所使用的武学而言更为粗浅的武学击败对手。",
      "ru": "Победите противника, который использует более продвинутую боевую технику, чем ваша.",
      "status": "machine",
      "srcHash": "8d7a879d1292e8dd",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_21": {
      "en": "Defeat an opponent whose Pure Essence is 3 levels (or more) higher than yours.",
      "cn": "在自己的精纯境界比对手低3或以上的情况下击败对手。",
      "ru": "Победите противника, чья чистая эссенция на 3 уровня (или более) выше вашей.",
