      "srcHash": "cf736ad713c7a655",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "Desc_27": {
      "en": "Defeated the Xiake who upholds justice.",
      "cn": "击败了行侠仗义的义士。",
      "ru": "Победил Сяке, который отстаивает справедливость.",
