    },
    "Desc_25": {
      "en": "Defeated the Outlaw who committed wrongdoings.",
      "cn": "击败了为非作歹的外道。",
      "ru": "Победил преступника, совершившего проступок.",
      "status": "machine",
      "srcHash": "e3d6e09e816aceeb",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_26": {
      "en": "Defeated the Outlaw whose Pure Essence is no less than yours.",
      "cn": "击败了精纯不低于自己的外道。",
      "ru": "Победил Преступника, чья Чистая эссенция ничуть не меньше вашей.",
