    },
    "Desc_25": {
      "en": "Defeated the Outlaw who committed wrongdoings.",
      "cn": "击败了为非作歹的外道。",
      "ru": "Победил преступника, совершившего проступок.",
      "status": "machine",
      "srcHash": "a7bdd02449633b68",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "Desc_26": {
      "en": "Defeated the Outlaw whose Pure Essence is no less than yours.",
      "cn": "击败了精纯不低于自己的外道。",
      "ru": "Победил Преступника, чья чистая эссенция ничуть не меньше вашей.",
      "status": "machine",
      "srcHash": "a753063fc48d8b1c",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_27": {
      "en": "Defeated the Xiake who upholds justice.",
      "cn": "击败了行侠仗义的义士。",
      "ru": "Победил Сяке, который отстаивает справедливость.",
