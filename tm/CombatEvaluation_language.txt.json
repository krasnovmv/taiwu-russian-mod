      "en": "Defeat an opponent whose Pure Essence is 3 levels (or more) lower than yours.",
      "cn": "在自己的精纯境界比对手高3或以上的情况下击败对手。",
      "ru": "Победите противника, чья Чистая эссенция на 3 уровня (или более) ниже вашей.",
      "status": "machine",
      "srcHash": "79aacd1cc85e3c65",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_15": {
      "en": "Defeat a pregnant opponent.",
      "cn": "击败身怀六甲的对手。",
      "ru": "Победите беременную соперницу.",
      "status": "machine",
      "srcHash": "06a11b4c8f074e16",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_16": {
      "en": "Defeat opponents who outnumber you.",
      "cn": "在我方人数比敌方人数少的情况下战胜对手。",
      "ru": "Побеждайте противников, которые превосходят вас численностью.",
      "status": "machine",
      "srcHash": "0a3c2849c894886e",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_17": {
      "en": "Defeat an opponent who is older than you when you are not of age.",
      "cn": "在尚未成年且对方比自己年长的情况下击败对手。",
      "ru": "Победите противника, который старше вас, когда вы еще не достигли совершеннолетия.",
      "status": "machine",
      "srcHash": "7d7b946d8b956866",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_18": {
      "en": "Defeat an opponent whose equipment is overall stronger than yours.",
      "cn": "击败装备整体比自己强的对手。",
      "ru": "Победите противника, чье Снаряжение в целом сильнее вашего.",
      "status": "machine",
      "srcHash": "619cbec8d3a38c30",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_19": {
      "en": "Defeat an opponent whose True Qi is much higher than yours.",
      "cn": "击败真气比自己高很多的对手。",
      "ru": "Победите противника, Истинная ци которого намного выше вашей.",
      "status": "machine",
      "srcHash": "6b82e05c4a6c9236",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_20": {
      "en": "Defeat an opponent who uses a more advanced Martial Art than yours.",
      "cn": "仅用了相较对手所使用的武学而言更为粗浅的武学击败对手。",
      "ru": "Победите противника, который использует более продвинутую Боевую технику, чем ваша.",
      "status": "machine",
      "srcHash": "ce725b028efab282",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "Desc_21": {
