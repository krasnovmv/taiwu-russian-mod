      "srcHash": "0755f5eea84abddc",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_27": {
      "en": "Defeated the Xiake who upholds justice.",
      "cn": "击败了行侠仗义的义士。",
      "ru": "Победил Сяке, который отстаивает справедливость.",
