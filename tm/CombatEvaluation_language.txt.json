    },
    "Desc_25": {
      "en": "Defeated the Outlaw who committed wrongdoings.",
      "cn": "击败了为非作歹的外道。",
      "ru": "Победил преступника, совершившего проступок.",
      "status": "machine",
      "srcHash": "004a801f7482d31e",
