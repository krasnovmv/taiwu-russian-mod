    "Desc_22": {
      "en": "Defeat an opponent when you are pregnant.",
      "cn": "在自己身怀六甲的情况下击败对手。",
      "ru": "Победите соперника, когда вы беременны.",
      "status": "machine",
      "srcHash": "d6a65c92e03eb992",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_23": {
      "en": "Restore the mind of an opponent who is bewitched by Xiangshu.",
      "cn": "令堕入相枢魔道者的心神得以复原。",
      "ru": "Восстановите разум противника, околдованного Сяншу.",
      "status": "machine",
      "srcHash": "e9f3041d6a909a69",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_24": {
      "en": "Restore the mind of an opponent who is bewitched by Xiangshu and has no less Pure Essence than you.",
      "cn": "令精纯不低于自己的堕入相枢魔道者的心神得以复原。",
      "ru": "Восстановите разум противника, который околдован Сяншу и обладает не менее Чистой эссенцией, чем вы.",
      "status": "machine",
      "srcHash": "4de6c88e2d39ff3d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_25": {
      "en": "Defeated the Outlaw who committed wrongdoings.",
      "cn": "击败了为非作歹的外道。",
      "ru": "Победил преступника, совершившего проступок.",
      "status": "machine",
      "srcHash": "885e298b70c9b62b",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_26": {
      "en": "Defeated the Outlaw whose Pure Essence is no less than yours.",
      "cn": "击败了精纯不低于自己的外道。",
      "ru": "Победил Преступника, чья Чистая эссенция ничуть не меньше вашей.",
      "status": "machine",
      "srcHash": "d184e887028fada3",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_27": {
      "en": "Defeated the Xiake who upholds justice.",
      "cn": "击败了行侠仗义的义士。",
      "ru": "Победил Сяке, который отстаивает справедливость.",
      "status": "machine",
      "srcHash": "a7745d19c84066eb",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_28": {
      "en": "Defeated the Xiake whose Pure Essence is no less than yours.",
      "cn": "击败了精纯不低于自己的义士。",
      "ru": "Победил Сяке, чья Чистая эссенция ничуть не меньше твоей.",
      "status": "machine",
      "srcHash": "c216c8de5b98b780",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_29": {
      "en": "The Lion-Face Clan now tirelessly celebrates your every feat. You gain more Prestige from beating your opponents.",
      "cn": "因为狮相门的宣扬，战胜对手获得了更多的威望。",
      "ru": "Клан Львинолицых теперь неустанно празднует каждый ваш подвиг. Вы получаете больше Престижа, побеждая своих противников.",
      "status": "machine",
      "srcHash": "c178089788871121",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "Desc_30": {
      "en": "The Lion-Face Clan now tirelessly celebrates your every feat. You gain more Prestige from beating your opponents.",
      "cn": "因为狮相门的宣扬，战胜对手获得了更多的威望。",
      "ru": "Клан Львинолицых теперь неустанно празднует каждый ваш подвиг. Вы получаете больше Престижа, побеждая своих противников.",
