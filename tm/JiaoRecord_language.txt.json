    "Desc_0": {
      "en": "After months of incubation, {0} finally broke out of {1}'s shell...",
      "cn": "连月孵化过后，{0}终于自{1}内破壳而出…",
      "ru": "После нескольких месяцев инкубации {0} наконец вырвался из оболочки {1}...",
      "status": "judged",
      "srcHash": "8a6b7ddf5f2c2076",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "0e915e3a4f31c8a9"
    },
    "Desc_1": {
      "en": "Due to the nurturing policy \"{1},\" {0}'s {2} has increased by {3}...",
      "cn": "由于养育方针「{1}」，{0}的{2}增加了{3}…",
      "ru": "Благодаря политике воспитания \"{1}\", {0} увеличил {2} на {3}...",
      "status": "judged",
      "srcHash": "611d5c155f0c3827",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "09255ecbf1452bbc"
    },
    "Desc_2": {
      "en": "Through the playful interaction with the group of fish, {0}'s inventory size increased by {1}...",
      "cn": "通过群鱼相戏，{0}的行囊大小增加了{1}…",
      "ru": "Благодаря игривому взаимодействию с группой рыб, размер инвентаря {0} увеличился на {1}...",
      "status": "judged",
      "srcHash": "acc1c01c7c662802",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "fdc8a7315a93d75e"
    },
    "Desc_3": {
      "en": "Through the water play and race, {0}'s travel speed increased by {1}%...",
      "cn": "通过水嬉竞渡，{0}的旅行速度增加了{1}%…",
      "ru": "Благодаря водным играм и гонкам, скорость перемещения {0} увеличена на {1}%...",
