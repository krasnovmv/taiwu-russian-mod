    "Desc_0": {
      "en": "After months of incubation, {0} finally broke out of {1}'s shell...",
      "cn": "连月孵化过后，{0}终于自{1}内破壳而出…",
      "ru": "После нескольких месяцев инкубации, {0} наконец-то вырвался из {1}это оболочка...",
      "status": "machine",
      "srcHash": "87399f27cdfe3128",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_1": {
      "en": "Due to the nurturing policy \"{1},\" {0}'s {2} has increased by {3}...",
      "cn": "由于养育方针「{1}」，{0}的{2}增加了{3}…",
      "ru": "Благодаря политике воспитания \"{1},\" {0}'s {2} увеличился на {3}...",
      "status": "machine",
      "srcHash": "474d95d60d0cfb8c",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_2": {
      "en": "Through the playful interaction with the group of fish, {0}'s inventory size increased by {1}...",
      "cn": "通过群鱼相戏，{0}的行囊大小增加了{1}…",
      "ru": "Благодаря игривому взаимодействию с группой рыб, {0}размер запасов увеличился на {1}...",
      "status": "machine",
      "srcHash": "f1f724adf3fce23d",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_3": {
      "en": "Through the water play and race, {0}'s travel speed increased by {1}%...",
      "cn": "通过水嬉竞渡，{0}的旅行速度增加了{1}%…",
      "ru": "По воде играйте и соревнуйтесь наперегонки, {0}скорость перемещения увеличена на {1}%...",
      "status": "machine",
      "srcHash": "2b9dc96ae9bd5d34",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_4": {
      "en": "Through the battle between the Loong and the Fenghuang, {0}'s Prisoner Slots increased by {1}...",
      "cn": "通过搏龙斗凤，{0}的关押栏位增加了{1}…",
      "ru": "Во время битвы между Лунами и Фэнхуанами, {0}количество мест для заключенных увеличилось на {1}...",
      "status": "machine",
      "srcHash": "f4720b8c2c23b20c",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_5": {
      "en": "{0}'s Exploration Reward Enrichment ability is increased by {1}% by playing gongs and drums…",
      "cn": "通过扬锣捣鼓，{0}丰富探索奖励的能力增加了{1}%…",
      "ru": "{0}способность к обогащению за вознаграждение за разведку увеличивается на {1}% играя на гонгах и барабанах…",
