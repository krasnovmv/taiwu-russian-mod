      "srcHash": "26f971b0c9a0f979",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_7": {
      "en": "{0}'s value is increased via Treasure Gifting...",
      "cn": "通过赠予珍宝，{0}的价值增加了…",
      "ru": "{0}ценность увеличивается за счет дарения сокровищ...",
