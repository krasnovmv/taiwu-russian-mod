    "Desc_0": {
      "en": "After months of incubation, {0} finally broke out of {1}'s shell...",
      "cn": "连月孵化过后，{0}终于自{1}内破壳而出…",
      "ru": "После нескольких месяцев инкубации {0} наконец вырвался из оболочки {1}...",
      "status": "judged",
      "srcHash": "8a6b7ddf5f2c2076",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "b505252b681d2748"
    },
    "Desc_1": {
      "en": "Due to the nurturing policy \"{1},\" {0}'s {2} has increased by {3}...",
      "cn": "由于养育方针「{1}」，{0}的{2}增加了{3}…",
      "ru": "Благодаря политике воспитания \"{1},\" значение {2} у {0} увеличилось на {3}...",
      "status": "judged",
      "srcHash": "611d5c155f0c3827",
      "engine": "yandex",
      "updatedAt": "2026-08-21T11:36:54.909Z",
      "judgeHash": "9d432bf509efff36"
    },
    "Desc_2": {
      "en": "Through the playful interaction with the group of fish, {0}'s inventory size increased by {1}...",
      "cn": "通过群鱼相戏，{0}的行囊大小增加了{1}…",
      "ru": "Благодаря игривому взаимодействию с группой рыб, размер инвентаря {0} увеличился на {1}...",
      "status": "judged",
      "srcHash": "acc1c01c7c662802",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "02ddc648c6a25a50"
    },
    "Desc_3": {
      "en": "Through the water play and race, {0}'s travel speed increased by {1}%...",
      "cn": "通过水嬉竞渡，{0}的旅行速度增加了{1}%…",
      "ru": "Благодаря водным играм и гонкам, скорость перемещения {0} увеличена на {1}%...",
      "status": "judged",
      "srcHash": "973d26a037a3345d",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "14df9a2f20007d44"
    },
    "Desc_4": {
      "en": "Through the battle between the Loong and the Fenghuang, {0}'s Prisoner Slots increased by {1}...",
      "cn": "通过搏龙斗凤，{0}的关押栏位增加了{1}…",
      "ru": "В ходе борьбы лунов и фэнхуанов у {0} количество слотов для заключённых увеличилось на {1}...",
      "status": "judged",
      "srcHash": "05165b37aee7be45",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:35:08.138Z",
      "judgeHash": "d784e91ee1ea33c5"
    },
    "Desc_5": {
      "en": "{0}'s Exploration Reward Enrichment ability is increased by {1}% by playing gongs and drums...",
      "cn": "通过扬锣捣鼓，{0}丰富探索奖励的能力增加了{1}%…",
      "ru": "Способность {0} обогащать награды за разведку увеличивается на {1}% благодаря игре на гонгах и барабанах...",
