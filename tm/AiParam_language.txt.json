      "updatedAt": "2026-07-10T22:05:17.320Z",
      "judgeHash": "6cd5e64597dbc3d7"
    },
    "Desc_20": {
      "en": "Weapon Input weapon name, such as Zhanlu, Juque",
      "cn": "输入兵器名，如湛卢、巨阙",
      "ru": "Оружие Введите название оружия, например Zhanlu, Juque",
      "status": "machine",
      "srcHash": "97df78169f8b1d7b",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_21": {
      "en": "Input weapon type, such as Needle Box, Piercer, Sword, Blade",
      "cn": "输入兵器类型，如针匣、对刺、剑、刀",
      "ru": "Введите тип оружия, например игольницу, парные клинки, меч, клинок",
