    "Desc_0": {
      "en": "Input any integer, but it cannot be greater than or equal to one billion or less than or equal to negative one billion",
      "cn": "输入任意整数，但不可大于等于十亿或小于等于负十亿",
      "ru": "Введите любое целое число, но оно не может быть больше или равно одному миллиарду или меньше или равно отрицательному миллиарду",
      "status": "machine",
      "srcHash": "342fd68792d2c41b",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_1": {
      "en": "Input any boolean, such as True or False",
      "cn": "输入任意布尔，如 True、False",
      "ru": "Введите любое логическое значение, например True или False",
      "status": "machine",
      "srcHash": "6e77c628d2fc3654",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_2": {
      "en": "Input the Martial Art name, it must be exactly the same as in the configuration table. If there are multiple Martial Arts with the same name, a warning will appear, and the first Martial Art with that name will be applied",
      "cn": "输入功法名，必须与配置表中功法名完全相同，若存在同名功法则会显示警告并应用首个该名称功法",
      "ru": "Введите название Боевой техники, оно должно быть точно таким же, как в таблице конфигурации. Если существует несколько Боевых техник с одинаковым названием, появится предупреждение, и будет применена первая Боевая техника с таким названием",
      "status": "machine",
      "srcHash": "77d367341855eea5",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_3": {
      "en": "Input any boolean, True represents the player side, False represents the opponent",
      "cn": "输入任意布尔，True 代表己方，False 代表对方",
      "ru": "Введите любое логическое значение, True представляет сторону игрока, False представляет противника",
      "status": "machine",
      "srcHash": "81cf8d15aa7b4297",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_4": {
      "en": "Input any text, such as \"abc123,\" \"example\"",
      "cn": "输入任意文本，如 “abc123”、“示例”",
      "ru": "Введите любой текст, например \"abc123\", \"пример\"",
      "status": "machine",
      "srcHash": "4c39bf70e6e5a18a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_5": {
      "en": "Input the battle difficulty name, such as Normal, Hard, Very Hard, or Doom",
      "cn": "输入战斗难度名称，如普通、困难、极难、必死",
      "ru": "Введите название сложности боя, например \"Обычная\", \"Сложная\", \"Очень сложная\" или \"Обреченная\".",
      "status": "machine",
      "srcHash": "5fcd1e85248f11f2",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_6": {
      "en": "Input a general companion command name, such as Attack, Defense, Control, etc. Negative commands cannot be entered",
      "cn": "输入一般同道指令名称，如攻击、防御、牵制等，不可输入负面指令",
      "ru": "Введите общее название сопутствующей команды, например, Атака, защита, управление и т.д. Отрицательные команды ввести невозможно",
      "status": "machine",
      "srcHash": "5e917b58aeb2cfff",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_7": {
      "en": "Input the active Martial Art type, such as Annihilation, Nimble, or Protection",
      "cn": "输入主动功法类型，如摧破、轻灵、护体",
      "ru": "Введите тип активной Боевой техники, такой как Сокрушение, Ловкость или защита",
      "status": "machine",
      "srcHash": "c909d7d4f5725b84",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_8": {
      "en": "Input other action types, such as Healing, Detox, Escape",
      "cn": "输入其它行为类型，如疗伤、驱毒、逃跑",
      "ru": "Введите другие типы действий, такие как исцеление, детоксикация, побег",
      "status": "machine",
      "srcHash": "aceae99c19475356",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_9": {
      "en": "Input any boolean, True represents the front yard, False represents the rear yard",
      "cn": "输入任意布尔，True 代表前方，False 代表后方",
      "ru": "Введите любое логическое значение, True представляет передний двор, False представляет задний двор",
      "status": "machine",
      "srcHash": "201cc57dd8862f80",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_10": {
      "en": "Input part name, such as Head-and-Neck, Left Arm, Right Leg",
      "cn": "输入部位名，如头颈、左臂、右腿",
      "ru": "Введите название детали, например, Голова и шея, левая рука, правая нога",
      "status": "machine",
      "srcHash": "4e5c5baf36f28b6a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_11": {
      "en": "Input an expression with Dispositions, such as 20 + Intelligence × 40 ÷ 100",
      "cn": "输入含有七元赋性类型的表达式，如 20 + 聪颖 × 40 ÷ 100",
      "ru": "Введите выражение с предрасположенностями, например 20 + Интеллект × 40 ÷ 100",
      "status": "machine",
      "srcHash": "d94a9b8749c4f61e",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_12": {
      "en": "Input any boolean, True represents Orthodox Training, False represents Heterodox Training",
      "cn": "输入任意布尔，True 代表正练，False 代表逆练",
      "ru": "Введите любое логическое значение, True представляет ортодоксальное обучение, False представляет неортодоксальное обучение",
      "status": "machine",
      "srcHash": "a077d913125c3db4",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_13": {
      "en": "Internal Input any boolean, True represents Internal, False represents External",
      "cn": "输入任意布尔，True 代表内，False 代表外",
      "ru": "Внутренний ввод - любое логическое значение, True представляет внутренний, False представляет внешний",
      "status": "machine",
      "srcHash": "9b5158797905af9c",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_14": {
      "en": "Input poison type, such as Acritoxin, Oneirotoxin",
      "cn": "输入毒素类型，如烈毒、幻毒",
      "ru": "Введите тип Яда, такой как Акритоксин, Онейротоксин",
      "status": "machine",
      "srcHash": "d9b5f75e4945900f",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_15": {
      "en": "Input any boolean, True represents grown, False represents not yet grown",
      "cn": "输入任意布尔，True 代表已成长的，False 代表未成长的",
      "ru": "Введите любое логическое значение, True означает выращенный, False означает еще не выращенный",
      "status": "machine",
      "srcHash": "d80ff99b0ff4df6a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_16": {
      "en": "Input any boolean, True represents Attuned, False represents Un-attuned",
      "cn": "输入任意布尔，True 代表已识主的，False 代表未识主的",
      "ru": "Введите любое логическое значение, True представляет настроенный, False представляет не настроенный",
      "status": "machine",
      "srcHash": "bf7acffa4fea570f",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_17": {
      "en": "Input the Gu type, such as Red-eye, Illusionary, Corruptive, Inner Demon, Tenebrous, Ice Silkworm, Golden Silkworm, Cyan, or input 0-7 to represent",
      "cn": "输入蛊虫类型，如赤目,魑魅,黑血,心魔,尸螭,冰蚕,金蚕,青髓，也可简化输入 0~7 来指代",
      "ru": "Введите тип Гу, такой как \"Красный глаз\", \"Иллюзорный\", \"Развращающий\", \"Внутренний демон\", \"Мрачный\", \"Ледяной шелкопряд\", \"Золотой шелкопряд\", \"Голубой\" или введите 0-7 для представления",
      "status": "machine",
      "srcHash": "827805542ef52821",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_18": {
      "en": "Input the True Qi type, such as Annihilation, Nimble, Protection, Acumen, or input 0-3 to represent",
      "cn": "输入真气类型，如摧破、轻灵、护体、奇窍，也可简化输入 0~3 来指代",
      "ru": "Введите тип Истинной ци, такой как Сокрушение, Ловкость, Защита, проницательность, или введите 0-3 для представления",
      "status": "machine",
      "srcHash": "bcd709507ea30c72",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_19": {
      "en": "Input style name, such as Hack, Stab, Upswing",
      "cn": "输入蓄式名，如劈、刺、撩",
      "ru": "Название стиля ввода, например Hack, Stab, Upswing",
      "status": "machine",
      "srcHash": "1ca6b7304c1fd25b",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_20": {
      "en": "Weapon Input weapon name, such as Zhanlu, Juque",
      "cn": "输入兵器名，如湛卢、巨阙",
      "ru": "Оружие Введите название Оружия, например Zhanlu, Juque",
      "status": "machine",
      "srcHash": "755b665213822855",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "Desc_21": {
      "en": "Input weapon type, such as Needle Box, Piercer, Sword, Blade",
      "cn": "输入兵器类型，如针匣、对刺、剑、刀",
      "ru": "Введите тип Оружия, например игольницу, Пирсинг, Меч, Клинок",
      "status": "machine",
      "srcHash": "ed1c8469fc998814",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
