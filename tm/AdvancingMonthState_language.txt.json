    },
    "HintText_1": {
      "en": "Seasons turn, worlds unfold.",
      "cn": "月份更替 人世演化",
      "ru": "Сменяются месяцы, развивается человеческий мир.",
      "status": "judged",
      "srcHash": "6f8d88ef694e88d5",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "89c1d4843fe386c6"
    },
    "HintText_2": {
      "en": "From birth to dust, the natural order decides.",
      "cn": "生老病死 天地有道",
      "ru": "Рождение, старость, болезнь и смерть — в Небе и Земле есть свой Путь.",
      "status": "judged",
      "srcHash": "b4e71a9d3c554d93",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "f6c795060c7d4bdb"
    },
    "HintText_3": {
      "en": "Demons prowl, and bandits raid.",
      "cn": "妖魔猖獗 盗匪肆虐",
      "ru": "Демоны рыщут, а бандиты совершают набеги.",
      "status": "machine",
      "srcHash": "edad4c16252fd432",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "2dacc2abfcd49fc6"
    },
    "HintText_4": {
      "en": "Drill at dawn, study by night.",
      "cn": "闻鸡起舞 夜读春秋",
      "ru": "Слушай петуха и упражняйся в мече, ночью читай \"Чуньцю\".",
      "status": "judged",
      "srcHash": "d07095e42b9fe2ca",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "ed4984e6e461ebe2"
    },
    "HintText_5": {
      "en": "Hoard your gold, refine your soul.",
      "cn": "藏金纳宝 外修内调",
      "ru": "Накапливай золото, совершенствуй дух.",
      "status": "judged",
      "srcHash": "7980c7c1c5782adc",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "0c14ba213988cdf3"
    },
    "HintText_6": {
      "en": "What matters lies within, not in the hold.",
      "cn": "身外之物 不足为惜",
      "ru": "Важно то, что внутри, а не внешние блага.",
      "status": "judged",
      "srcHash": "0c11a33f67660912",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "b9de6e0ef946770b"
    },
    "HintText_7": {
      "en": "By the river's heart, the lovebirds still cry.",
      "cn": "关关雎鸠 在河之洲",
      "ru": "\"Гуань-гуань кричат цзю-цю на острове реки.\"",
      "status": "judged",
      "srcHash": "aa6b1299b8d98467",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "e4c6b5fec683ee97"
    },
    "HintText_8": {
      "en": "Passions burn, desires abide.",
      "cn": "七情难灭 六欲难消",
      "ru": "Страсти трудно погасить, желания трудно рассеять.",
      "status": "judged",
      "srcHash": "4d17be3a3eaa251c",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "bc0c69f22f102377"
    },
    "HintText_9": {
      "en": "Time and tide wait for no man.",
      "cn": "光阴似箭 时不我待",
      "ru": "Время и течение не ждут никого.",
      "status": "judged",
      "srcHash": "7c0d9c7d08079238",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "0dcd57501b3885c4"
    },
    "HintText_10": {
      "en": "Through chaos, just wander bold.",
      "cn": "纷纷乱世 且闯且游",
      "ru": "В смутные времена смело странствуй и прокладывай путь.",
      "status": "judged",
      "srcHash": "5573eac4f895d690",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "7e9b3496aab92eb0"
    },
    "HintText_11": {
      "en": "Never romanticize a sorrow you haven't truly known.",
      "cn": "未见烟雨 不画悲秋",
      "ru": "Не романтизируй печаль, которую не испытал на себе.",
      "status": "judged",
      "srcHash": "cc753dd0b5925ac3",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:16:55.214Z",
      "judgeHash": "25c5d6faceb5f722"
    },
    "HintText_12": {
      "en": "Rumors cut like ice and burn like fire.",
      "cn": "流言蜚语 也冰也炽",
      "ru": "Слухи режут, как лед, и обжигают, как огонь.",
      "status": "machine",
      "srcHash": "845338d49bdf230a",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "1554ff56f049b3b5"
    },
    "HintText_13": {
      "en": "Life is fickle.",
      "cn": "祸福难料 生死难知",
      "ru": "Жизнь непостоянна.",
      "status": "machine",
      "srcHash": "c8ad3e632e58496e",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
