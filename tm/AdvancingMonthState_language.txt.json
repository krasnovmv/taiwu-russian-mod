    },
    "HintText_1": {
      "en": "Seasons turn, worlds unfold.",
      "cn": "月份更替 人世演化",
      "ru": "Сменяются времена года, раскрываются миры.",
      "status": "machine",
      "srcHash": "260668dfbe55953b",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "HintText_2": {
      "en": "From birth to dust, the natural order decides.",
      "cn": "生老病死 天地有道",
      "ru": "От рождения до праха все решает естественный порядок вещей.",
      "status": "machine",
      "srcHash": "a105c0428a0af8e7",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "HintText_3": {
      "en": "Demons prowl, and bandits raid.",
      "cn": "妖魔猖獗 盗匪肆虐",
      "ru": "Демоны рыщут, а бандиты совершают набеги.",
      "status": "machine",
      "srcHash": "6681860b1e7d78bf",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "HintText_4": {
      "en": "Drill at dawn, study by night.",
      "cn": "闻鸡起舞 夜读春秋",
      "ru": "Тренируйся на рассвете, учись ночью.",
      "status": "machine",
      "srcHash": "47db2df1ad1458a1",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "HintText_5": {
      "en": "Hoard your gold, refine your soul.",
      "cn": "藏金纳宝 外修内调",
      "ru": "Копи свое золото, очищай свою душу.",
      "status": "machine",
      "srcHash": "c8dcdc677cc36bf2",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "HintText_6": {
      "en": "What matters lies within, not in the hold.",
      "cn": "身外之物 不足为惜",
      "ru": "То, что имеет значение, находится внутри, а не в трюме.",
      "status": "machine",
      "srcHash": "04fe9f5b76596d6c",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "HintText_7": {
      "en": "By the river's heart, the lovebirds still cry.",
      "cn": "关关雎鸠 在河之洲",
      "ru": "У сердца реки все еще плачут влюбленные птички.",
      "status": "machine",
      "srcHash": "d308a66c8bc71e0b",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "HintText_8": {
      "en": "Passions burn, desires abide.",
      "cn": "七情难灭 六欲难消",
      "ru": "Страсти пылают, желания остаются неизменными.",
      "status": "machine",
      "srcHash": "a0c6bfd8dbe909e8",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "HintText_9": {
      "en": "Time and tide wait for no man.",
      "cn": "光阴似箭 时不我待",
      "ru": "Время и прилив никого не ждут.",
      "status": "machine",
      "srcHash": "f40792861d4c5ad1",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "HintText_10": {
      "en": "Through chaos, just wander bold.",
      "cn": "纷纷乱世 且闯且游",
      "ru": "Просто смело броди по хаосу.",
      "status": "machine",
      "srcHash": "cbb9d8af4d765eb4",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "HintText_11": {
      "en": "Never romanticize a sorrow you haven't truly known.",
      "cn": "未见烟雨 不画悲秋",
      "ru": "Никогда не романтизируй горе, которого ты по-настоящему не знал.",
      "status": "machine",
      "srcHash": "4d24bff1d6707e3b",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "HintText_12": {
      "en": "Rumors cut like ice and burn like fire.",
      "cn": "流言蜚语 也冰也炽",
      "ru": "Слухи режут, как лед, и обжигают, как огонь.",
      "status": "machine",
      "srcHash": "eeb6dbbbe8fbeefd",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "HintText_13": {
      "en": "Life is fickle.",
      "cn": "祸福难料 生死难知",
      "ru": "Жизнь непостоянна.",
      "status": "machine",
      "srcHash": "032b648d1d8279f3",
      "engine": "yandex",
      "updatedAt": "2026-06-20T21:49:13.615Z"
    },
    "HintText_14": {
      "en": "",
      "cn": "",
      "ru": "",
      "status": "machine",
      "srcHash": "166f829e016f2315",
