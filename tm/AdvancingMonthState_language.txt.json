    },
    "HintText_1": {
      "en": "Seasons turn, worlds unfold.",
      "cn": "月份更替 人世演化",
      "ru": "Сменяются времена года, раскрываются миры.",
      "status": "machine",
      "srcHash": "2cbda998af81a2bf",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_2": {
      "en": "From birth to dust, the natural order decides.",
      "cn": "生老病死 天地有道",
      "ru": "От рождения до праха все решает естественный порядок вещей.",
      "status": "machine",
      "srcHash": "c9d1e9726fec899e",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_3": {
      "en": "Demons prowl, and bandits raid.",
      "cn": "妖魔猖獗 盗匪肆虐",
      "ru": "Демоны рыщут, а бандиты совершают набеги.",
      "status": "machine",
      "srcHash": "22b79aa52900eef6",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_4": {
      "en": "Drill at dawn, study by night.",
      "cn": "闻鸡起舞 夜读春秋",
      "ru": "Тренируйся на рассвете, учись ночью.",
      "status": "machine",
      "srcHash": "d90b0d685c536b5d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_5": {
      "en": "Hoard your gold, refine your soul.",
      "cn": "藏金纳宝 外修内调",
      "ru": "Копи свое золото, очищай свою душу.",
      "status": "machine",
      "srcHash": "5161a0afd6df6f29",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_6": {
      "en": "What matters lies within, not in the hold.",
      "cn": "身外之物 不足为惜",
      "ru": "То, что имеет значение, находится внутри, а не в трюме.",
      "status": "machine",
      "srcHash": "71551b05c491a212",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_7": {
      "en": "By the river's heart, the lovebirds still cry.",
      "cn": "关关雎鸠 在河之洲",
      "ru": "У сердца реки все еще плачут влюбленные птички.",
      "status": "machine",
      "srcHash": "9dd7472c7868b1a0",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_8": {
      "en": "Passions burn, desires abide.",
      "cn": "七情难灭 六欲难消",
      "ru": "Страсти пылают, желания остаются неизменными.",
      "status": "machine",
      "srcHash": "f0bbc454ee5bc214",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_9": {
      "en": "Time and tide wait for no man.",
      "cn": "光阴似箭 时不我待",
      "ru": "Время и прилив никого не ждут.",
      "status": "machine",
      "srcHash": "0712c0fadc5fbdc0",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_10": {
      "en": "Through chaos, just wander bold.",
      "cn": "纷纷乱世 且闯且游",
      "ru": "Просто смело броди по хаосу.",
      "status": "machine",
      "srcHash": "972d32cdb38c3e79",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_11": {
      "en": "Never romanticize a sorrow you haven't truly known.",
      "cn": "未见烟雨 不画悲秋",
      "ru": "Никогда не романтизируй горе, которого ты по-настоящему не знал.",
      "status": "machine",
      "srcHash": "7757cd081bd38a3e",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_12": {
      "en": "Rumors cut like ice and burn like fire.",
      "cn": "流言蜚语 也冰也炽",
      "ru": "Слухи режут, как лед, и обжигают, как огонь.",
      "status": "machine",
      "srcHash": "430db8f3c6fde674",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_13": {
      "en": "Life is fickle.",
      "cn": "祸福难料 生死难知",
      "ru": "Жизнь непостоянна.",
      "status": "machine",
      "srcHash": "6381ef71e8fbd7a5",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "HintText_14": {
