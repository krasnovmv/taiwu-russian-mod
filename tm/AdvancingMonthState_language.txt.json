    },
    "HintText_1": {
      "en": "Seasons turn, worlds unfold.",
      "cn": "月份更替 人世演化",
      "ru": "Сменяются времена года, раскрываются миры.",
      "status": "machine",
      "srcHash": "6f8d88ef694e88d5",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_2": {
      "en": "From birth to dust, the natural order decides.",
      "cn": "生老病死 天地有道",
      "ru": "От рождения до праха все решает естественный порядок вещей.",
      "status": "machine",
      "srcHash": "b4e71a9d3c554d93",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_3": {
      "en": "Demons prowl, and bandits raid.",
      "cn": "妖魔猖獗 盗匪肆虐",
      "ru": "Демоны рыщут, а бандиты совершают набеги.",
      "status": "machine",
      "srcHash": "edad4c16252fd432",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_4": {
      "en": "Drill at dawn, study by night.",
      "cn": "闻鸡起舞 夜读春秋",
      "ru": "Тренируйся на рассвете, учись ночью.",
      "status": "machine",
      "srcHash": "d07095e42b9fe2ca",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_5": {
      "en": "Hoard your gold, refine your soul.",
      "cn": "藏金纳宝 外修内调",
      "ru": "Копи свое золото, очищай свою душу.",
      "status": "machine",
      "srcHash": "7980c7c1c5782adc",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_6": {
      "en": "What matters lies within, not in the hold.",
      "cn": "身外之物 不足为惜",
      "ru": "То, что имеет значение, находится внутри, а не в трюме.",
      "status": "machine",
      "srcHash": "0c11a33f67660912",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_7": {
      "en": "By the river's heart, the lovebirds still cry.",
      "cn": "关关雎鸠 在河之洲",
      "ru": "У сердца реки все еще плачут влюбленные птички.",
      "status": "machine",
      "srcHash": "aa6b1299b8d98467",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_8": {
      "en": "Passions burn, desires abide.",
      "cn": "七情难灭 六欲难消",
      "ru": "Страсти пылают, желания остаются неизменными.",
      "status": "machine",
      "srcHash": "4d17be3a3eaa251c",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_9": {
      "en": "Time and tide wait for no man.",
      "cn": "光阴似箭 时不我待",
      "ru": "Время и прилив никого не ждут.",
      "status": "machine",
      "srcHash": "7c0d9c7d08079238",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_10": {
      "en": "Through chaos, just wander bold.",
      "cn": "纷纷乱世 且闯且游",
      "ru": "Просто смело броди по хаосу.",
      "status": "machine",
      "srcHash": "5573eac4f895d690",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_11": {
      "en": "Never romanticize a sorrow you haven't truly known.",
      "cn": "未见烟雨 不画悲秋",
      "ru": "Никогда не романтизируй горе, которого ты по-настоящему не знал.",
      "status": "machine",
      "srcHash": "cc753dd0b5925ac3",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_12": {
      "en": "Rumors cut like ice and burn like fire.",
      "cn": "流言蜚语 也冰也炽",
      "ru": "Слухи режут, как лед, и обжигают, как огонь.",
      "status": "machine",
      "srcHash": "845338d49bdf230a",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "HintText_13": {
      "en": "Life is fickle.",
      "cn": "祸福难料 生死难知",
      "ru": "Жизнь непостоянна.",
      "status": "machine",
      "srcHash": "c8ad3e632e58496e",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
