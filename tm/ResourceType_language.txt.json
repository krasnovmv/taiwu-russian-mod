      "srcHash": "bc823352b67e72f8",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "Desc_4": {
      "en": "Common plants, silks, hides and the like.",
      "cn": "寻常植物、丝茧、毛皮等。",
      "ru": "Обычные растения, шелк, шкуры и тому подобное.",
