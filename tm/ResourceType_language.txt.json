    "Desc_0": {
      "en": "Common grains, poultries, meats and the like.",
      "cn": "寻常五谷、杂粮、禽畜等。",
      "ru": "Обычные крупы, домашняя птица, мясо и тому подобное.",
      "status": "machine",
      "srcHash": "04c2513072a6f2e0",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_1": {
      "en": "Common timbers, bamboo stalks, vines and the like.",
      "cn": "寻常木料、竹枝、藤蔓等。",
      "ru": "Обычные бревна, стебли бамбука, виноградные лозы и тому подобное.",
      "status": "machine",
      "srcHash": "70569e04217ec63c",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_2": {
      "en": "Common gold, silver, copper, iron and the like.",
      "cn": "寻常金银、铜铁等。",
      "ru": "Обычное золото, серебро, медь, железо и тому подобное.",
      "status": "machine",
      "srcHash": "b910c0832d29a257",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_3": {
      "en": "Common jade and stone.",
      "cn": "寻常玉料、石料等。",
      "ru": "Обычный Нефрит и камень.",
      "status": "machine",
      "srcHash": "7ad4898e30c7b5bd",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "Desc_4": {
      "en": "Common plants, silks, hides and the like.",
      "cn": "寻常植物、丝茧、毛皮等。",
      "ru": "Обычные растения, шелк, шкуры и тому подобное.",
      "status": "machine",
      "srcHash": "e24afc0a38527767",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_5": {
      "en": "Common herbs, include minerals and parts of plants, insects, animals and so on.",
      "cn": "来自于各类草木、矿石、虫、兽等物的寻常药材。",
      "ru": "Распространенные Травы, включают минералы и части растений, насекомых, животных и так далее.",
      "status": "machine",
      "srcHash": "375144c3b27cbc68",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_6": {
      "en": "Coins minted using brass and silver alloy, resembling currencies of the fallen dynasty.",
      "cn": "依照前朝通宝的样式以黄铜混合白银铸造而成的钱币。",
      "ru": "Монеты, отчеканенные с использованием сплава латуни и серебра, напоминают валюты павшей династии.",
      "status": "machine",
      "srcHash": "4bcc00261a52e0f0",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:16:14.880Z"
    },
    "Desc_7": {
      "en": "Fame and power gained through admiration and awe, no matter from common people, major sects or evildoers.",
      "cn": "由百姓、武林中人甚至是外道恶徒的仰慕、敬畏汇集而来的权威。",
      "ru": "Слава и власть обретаются благодаря восхищению и благоговению, независимо от того, исходят ли они от простых людей, крупных сект или злодеев.",
      "status": "machine",
      "srcHash": "f67f780b336b8672",
      "engine": "yandex",
      "updatedAt": "2026-06-21T01:54:40.039Z"
    }
