      "srcHash": "53cd0c7a1bf30548",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "Desc_2": {
      "en": "Common gold, silver, copper, iron and the like.",
      "cn": "寻常金银、铜铁等。",
      "ru": "Обычное золото, серебро, медь, железо и тому подобное.",
      "status": "machine",
      "srcHash": "48a05825f50e22d8",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "Desc_3": {
