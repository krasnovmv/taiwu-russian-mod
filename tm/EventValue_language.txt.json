    "Desc_6": {
      "en": "An actual case of the tile character talking to the player. Only events triggered by tapping the tile character will insert the parameter.",
      "cn": "当前与玩家对话的地格人物实例. 只有通过点击地格人物等方式触发的事件会填充该参数.",
      "ru": "Фактический экземпляр персонажа на клетке, общающегося с игроком. Параметр заполняется только в событиях, запускаемых кликом по персонажу на клетке и т.п.",
      "status": "judged",
      "srcHash": "0f9a2ff090892635",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "92a207b63648c90a"
    },
    "Desc_38": {
      "en": "The Encounter Element being processed currently. Only events triggered through Encounter Element will insert the parameter.",
      "cn": "当前正在处理的奇遇元素. 只有通过奇遇元素触发的事件会填充该参数.",
      "ru": "Элемент приключения, обрабатываемый в данный момент. Параметр будет вставлен только в события, запускаемые через элемент приключения.",
      "status": "judged",
      "srcHash": "fec90ff8fc795d2a",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "2a9f2b4232a19afc"
    },
    "Desc_39": {
      "en": "An actual case of character on the left in event settings.",
      "cn": "事件配置的左侧人物实例.",
      "ru": "Фактический экземпляр персонажа слева в настройках события.",
      "status": "judged",
      "srcHash": "0d9e7b13b91342ee",
      "engine": "yandex",
      "updatedAt": "2026-07-16T02:32:08.885Z",
      "judgeHash": "469f87488f5d1015"
    },
    "Desc_40": {
      "en": "An actual case of character on the right in event settings.",
      "cn": "事件配置的右侧人物实例.",
      "ru": "Фактический экземпляр персонажа справа в настройках события.",
      "status": "judged",
