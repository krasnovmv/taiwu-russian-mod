    "KindContent_15": {
      "en": "I have lost my move, it's fine to stop here...",
      "cn": "我已棋输先着，无妨就此罢手……",
      "ru": "Я сбился с пути, можно остановиться здесь...",
      "status": "machine",
      "srcHash": "611f15cb7131b31d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "KindContent_16": {
      "en": "I prefer peace, would you be willing to concede?",
      "cn": "我愿以和为贵，你可愿就此服输？",
      "ru": "Я предпочитаю мир, готовы ли вы уступить?",
      "status": "machine",
      "srcHash": "621330e0f90c38ec",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "KindContent_17": {
      "en": "How can we know who will win without a debate?",
      "cn": "未曾一辩，怎知谁胜谁负？",
      "ru": "Как мы можем узнать, кто победит, без Диспута?",
      "status": "machine",
      "srcHash": "ddb97a8e6ebb5056",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этой области, я смиренно признаю свою неполноценность...",
      "status": "machine",
      "srcHash": "30ea453d2f1027f7",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Победа или поражение решены, справедливость лежит в сердцах людей...",
      "status": "machine",
      "srcHash": "9922721788f97ddf",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, все будет оценено справедливо...",
      "status": "machine",
      "srcHash": "ffe9b9a6ebddb75a",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
      "srcHash": "51029d6bba0197b8",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_2": {
      "en": "That seems reasonable...",
      "cn": "如此亦无不可……",
      "ru": "Это кажется разумным...",
      "status": "machine",
      "srcHash": "04f09ea453456fec",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_3": {
      "en": "Anything will do...",
      "cn": "皆可，皆可……",
      "ru": "Подойдет все, что угодно...",
      "status": "machine",
      "srcHash": "1d05dd09c4eb966b",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
