      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "KindContent_16": {
      "en": "I prefer peace, would you be willing to concede?",
      "cn": "我愿以和为贵，你可愿就此服输？",
      "ru": "Я предпочитаю мир, готовы ли вы уступить?",
      "status": "machine",
      "srcHash": "68ab73bf3a06bad4",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "KindContent_17": {
      "en": "How can we know who will win without a debate?",
      "cn": "未曾一辩，怎知谁胜谁负？",
      "ru": "Как мы можем узнать, кто победит, без Диспута?",
      "status": "machine",
      "srcHash": "8a27a135fb7c5362",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этой области, я смиренно признаю свою неполноценность...",
      "status": "machine",
      "srcHash": "c8b584afbf101b8b",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Победа или поражение решены, справедливость лежит в сердцах людей...",
      "status": "machine",
      "srcHash": "06bd9eeca75bc4f1",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, все будет оценено справедливо...",
      "status": "machine",
      "srcHash": "79dd27645abcb888",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
      "srcHash": "91f915a940cd7294",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_2": {
      "en": "That seems reasonable...",
      "cn": "如此亦无不可……",
      "ru": "Это кажется разумным...",
      "status": "machine",
      "srcHash": "a11e0a73a2073a74",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_3": {
      "en": "Anything will do...",
      "cn": "皆可，皆可……",
      "ru": "Подойдет все, что угодно...",
      "status": "machine",
      "srcHash": "c6e5ba00ac054810",
