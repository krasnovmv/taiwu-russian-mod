      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "8d2e0211633710f3"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
