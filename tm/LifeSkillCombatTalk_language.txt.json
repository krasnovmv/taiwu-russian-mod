    "JustContent_15": {
      "en": "You've outplayed me. I give up.",
      "cn": "你确实技艺过人，我认输！",
      "ru": "Ты переиграл меня. Я сдаюсь.",
      "status": "machine",
      "srcHash": "1d13189a264b5998",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "JustContent_16": {
      "en": "If you are not as skilled, why not admit defeat?",
      "cn": "若你技不如人，何不知难而退？",
      "ru": "Если вы не столь опытны, почему бы не признать поражение?",
      "status": "machine",
      "srcHash": "e296a24a2e103f41",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "JustContent_17": {
      "en": "I see your skills are ordinary, you may not win!",
      "cn": "我观你技艺平平，未必能胜！",
      "ru": "Я вижу, что твои навыки заурядны, ты можешь и не победить!",
      "status": "machine",
      "srcHash": "850020d8a58b724a",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "JustContent_18": {
      "en": "Your skill is astonishing, I bow to you...",
      "cn": "是你技惊四座，我甘拜下风……",
      "ru": "Ваше мастерство поразительно, я преклоняюсь перед вами...",
      "status": "machine",
      "srcHash": "7258127c209e9506",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "JustContent_19": {
      "en": "I win! It was worth all the years of hard practice...",
      "cn": "我胜了！不枉多年刻苦修习……",
      "ru": "Я победил! Это стоило всех лет упорной практики...",
      "status": "machine",
      "srcHash": "0d51aea8ed7875af",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "KindContent_0": {
      "en": "You and I are merely expressing our own views...",
      "cn": "你我不过是各抒己见……",
      "ru": "Мы с вами просто выражаем наши собственные взгляды...",
      "status": "machine",
      "srcHash": "60328d020852d40f",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "KindContent_1": {
      "en": "Then as you wish...",
      "cn": "便依你所愿……",
      "ru": "Тогда как вы пожелаете...",
      "status": "machine",
      "srcHash": "ab2a4b714afdd3d5",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "KindContent_2": {
      "en": "Let me give you some leeway; it won't hurt...",
      "cn": "且让你一让，倒也无妨……",
      "ru": "Позволь мне дать тебе некоторую свободу действий; это не повредит...",
      "status": "machine",
      "srcHash": "89b68dca4cc90e24",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "KindContent_3": {
      "en": "No need to worry...",
      "cn": "无需心存顾虑……",
      "ru": "Не стоит беспокоиться...",
      "status": "machine",
