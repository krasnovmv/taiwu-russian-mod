      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "479ccfec1c69098b"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Исход битвы определён, а истина — в сердцах людей…",
      "status": "judged",
      "srcHash": "78d665b9c9608ea2",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "dafca206d808f9e1"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, всё будет оценено справедливо...",
      "status": "judged",
