    "RebelContent_15": {
      "en": "Fine, it's no longer interesting to debate with you now!",
      "cn": "也罢，此时与你较艺亦是无趣！",
      "ru": "Ладно, теперь с тобой больше неинтересно Диспут вести!",
      "status": "machine",
      "srcHash": "1b1c7dc391ea29f3",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_16": {
      "en": "If you bow out now, I will spare you this time!",
      "cn": "你若低头认输，我便饶你一回！",
      "ru": "Если ты сейчас откажешься, я пощажу тебя на этот раз!",
      "status": "machine",
      "srcHash": "492ea2c2601464d6",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_17": {
      "en": "You speak arrogantly, but who knows the outcome?",
      "cn": "口出狂言，却不知究竟鹿死谁手！",
      "ru": "Ты говоришь высокомерно, но кто знает, чем все закончится?",
      "status": "machine",
      "srcHash": "4d4ddfdbc5fece9e",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_18": {
      "en": "Strange, did you use any underhanded tricks?",
      "cn": "怪哉，莫不是你使了什么阴招？",
      "ru": "Странно, вы использовали какие-нибудь закулисные уловки?",
      "status": "machine",
      "srcHash": "1ba67c181a9a5076",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_19": {
      "en": "Ha-ha! What else do you have to say?",
      "cn": "哈哈！你还有何话要说？",
      "ru": "Ха-ха! Что еще ты можешь сказать?",
      "status": "machine",
      "srcHash": "656d31dbc4704b95",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
      "status": "machine",
      "srcHash": "ed96f6a79cc59af9",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EgoisticContent_1": {
      "en": "This is still futile...",
      "cn": "此举亦是徒劳……",
      "ru": "Это все равно бесполезно...",
      "status": "machine",
      "srcHash": "08a1ceeaf343740b",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EgoisticContent_2": {
      "en": "Why be so cautious?",
      "cn": "何必如此慎之又慎……",
      "ru": "Зачем быть таким осторожным?",
      "status": "machine",
      "srcHash": "377975f8324f6443",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EgoisticContent_3": {
      "en": "Show me your stuff.​..",
