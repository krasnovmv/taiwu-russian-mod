      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_17": {
      "en": "Right and wrong must be settled in debate...",
      "cn": "是非对错，还需一辩方知……",
      "ru": "Правильное и неправильное должно решаться в ходе Диспута...",
      "status": "machine",
      "srcHash": "b4182b77d177e12c",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_18": {
      "en": "The judgment is clear, it turns out I've lost...",
      "cn": "是非已定，原来是我败了……",
      "ru": "Решение ясное, оказывается, я проиграл...",
      "status": "machine",
      "srcHash": "82e484ff79544b77",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "EvenContent_19": {
      "en": "Deep research has brought me this victory...",
      "cn": "钻研至深，如今自能取胜……",
      "ru": "Глубокие исследования принесли мне эту победу...",
      "status": "machine",
      "srcHash": "b5ce5c7c7c78868a",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_0": {
      "en": "It's not too late for you to concede!",
      "cn": "趁早认输还来得及！",
      "ru": "Тебе еще не поздно уступить!",
      "status": "machine",
      "srcHash": "4776655d730eb1a5",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_1": {
      "en": "Are you afraid?",
      "cn": "你是怕了不成？",
      "ru": "Ты боишься?",
      "status": "machine",
      "srcHash": "1aacdfe4aef7b8b5",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_2": {
      "en": "Lack of proficiency is why you resorted to that...",
      "cn": "本事不足，方才如此……",
      "ru": "Недостаток мастерства - вот почему вы прибегли к этому...",
      "status": "machine",
      "srcHash": "a839501afe617133",
      "engine": "yandex",
      "updatedAt": "2026-07-03T19:38:47.709Z"
    },
    "RebelContent_3": {
      "en": "Don't try to play tricks...",
      "cn": "你可不要耍心眼……",
      "ru": "Не пытайся подшутить надо мной...",
      "status": "machine",
      "srcHash": "1580197203f5fe27",
