      "judgeHash": "cf0b344bf6c1dacc"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этом деле, я смиренно признаю, что не дотягиваю...",
      "status": "judged",
