    "JustContent_0": {
      "en": "Today's debate will reveal who is superior...",
      "cn": "今日一辩，便知高下……",
      "ru": "Сегодняшние Диспуты покажут, кто из них лучше...",
      "status": "machine",
      "srcHash": "51097c2e4e816f48",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "JustContent_1": {
      "en": "A resort to your advantage...",
      "cn": "不过是投机取巧……",
      "ru": "Курорт в ваших интересах...",
      "status": "machine",
      "srcHash": "efa4e3c86738a3a3",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "JustContent_2": {
      "en": "Why bother with that if you're truly well-learned?",
      "cn": "若博学广识，何必如此大费周章？",
      "ru": "Зачем утруждать себя этим, если вы действительно хорошо образованы?",
      "status": "machine",
      "srcHash": "ec1301741d8e85fb",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "JustContent_3": {
      "en": "Choose as you like, I fear nothing!",
      "cn": "任你择选，我皆不惧！",
      "ru": "Выбирай, как тебе нравится, я ничего не боюсь!",
      "status": "machine",
      "srcHash": "b033044604e040e5",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
