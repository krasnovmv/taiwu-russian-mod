      "updatedAt": "2026-06-20T20:14:49.687Z"
    },
    "EgoisticContent_7": {
      "en": "Such trivial gains are beneath my notice!",
      "cn": "这等小利，我尚且不放在眼里！",
      "ru": "Такие тривиальные выгоды недостойны моего внимания!",
      "status": "machine",
      "srcHash": "cfca67698e12367d",
      "engine": "yandex",
