      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "d420d4e922ad488f"
    },
    "EvenContent_18": {
      "en": "The judgment is clear, it turns out I've lost...",
      "cn": "是非已定，原来是我败了……",
      "ru": "Вердикт ясен, оказывается, я проиграл...",
      "status": "judged",
      "srcHash": "b7626635894b9497",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "85fca813f34db6c3"
    },
    "EvenContent_19": {
      "en": "Deep research has brought me this victory...",
      "cn": "钻研至深，如今自能取胜……",
      "ru": "Глубокие исследования принесли мне эту победу...",
      "status": "machine",
      "srcHash": "482b8c7e3f921186",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "0829314395ad11b3"
    },
    "RebelContent_0": {
      "en": "It's not too late for you to concede!",
      "cn": "趁早认输还来得及！",
      "ru": "Тебе еще не поздно уступить!",
      "status": "machine",
      "srcHash": "3ba5f3ec7337d360",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "b589cd756c0ded51"
    },
    "RebelContent_1": {
      "en": "Are you afraid?",
      "cn": "你是怕了不成？",
      "ru": "Ты боишься?",
      "status": "machine",
      "srcHash": "c2a85ee3d46e16fb",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "b38fa74a48fc0913"
    },
    "RebelContent_2": {
      "en": "Lack of proficiency is why you resorted to that...",
      "cn": "本事不足，方才如此……",
      "ru": "Недостаток мастерства — вот почему так поступили...",
      "status": "judged",
      "srcHash": "78aa984bedbfc212",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "013c7c1a1deb44fc"
    },
    "RebelContent_3": {
      "en": "Don't try to play tricks...",
      "cn": "你可不要耍心眼……",
      "ru": "Не пытайся хитрить...",
      "status": "judged",
      "srcHash": "53b5754e8908737f",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "be4a5d07993ab007"
