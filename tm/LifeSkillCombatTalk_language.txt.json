      "srcHash": "a4d7d891d5298d6a",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
