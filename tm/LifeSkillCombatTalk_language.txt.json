    "RebelContent_15": {
      "en": "Fine, it's no longer interesting to debate with you now!",
      "cn": "也罢，此时与你较艺亦是无趣！",
      "ru": "Ладно, теперь с тобой больше неинтересно диспут вести!",
      "status": "machine",
      "srcHash": "9e4429454404f6ae",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "RebelContent_16": {
      "en": "If you bow out now, I will spare you this time!",
      "cn": "你若低头认输，我便饶你一回！",
      "ru": "Если ты сейчас откажешься, я пощажу тебя на этот раз!",
      "status": "machine",
      "srcHash": "eed4d934fd467524",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_17": {
      "en": "You speak arrogantly, but who knows the outcome?",
      "cn": "口出狂言，却不知究竟鹿死谁手！",
      "ru": "Ты говоришь высокомерно, но кто знает, чем все закончится?",
      "status": "machine",
      "srcHash": "e16e0bcb87ecd31c",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_18": {
      "en": "Strange, did you use any underhanded tricks?",
      "cn": "怪哉，莫不是你使了什么阴招？",
      "ru": "Странно, вы использовали какие-нибудь закулисные уловки?",
      "status": "machine",
      "srcHash": "39dd633b4fde7d77",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_19": {
      "en": "Ha-ha! What else do you have to say?",
      "cn": "哈哈！你还有何话要说？",
      "ru": "Ха-ха! Что еще ты можешь сказать?",
      "status": "machine",
      "srcHash": "7ac530f5e32177c7",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
      "status": "machine",
      "srcHash": "c0d1cc19f7df2c72",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_1": {
      "en": "This is still futile...",
      "cn": "此举亦是徒劳……",
      "ru": "Это все равно бесполезно...",
      "status": "machine",
      "srcHash": "e6d05dd499166e44",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_2": {
      "en": "Why be so cautious?",
      "cn": "何必如此慎之又慎……",
      "ru": "Зачем быть таким осторожным?",
      "status": "machine",
      "srcHash": "e6f537f87fac6136",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_3": {
      "en": "Show me your stuff.​..",
      "cn": "叫我瞧瞧你的能耐……",
      "ru": "Покажи мне свои вещи....",
