      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EgoisticContent_19": {
      "en": "It is only natural for me to win...",
      "cn": "我能得胜，也是理所应当……",
      "ru": "Для меня вполне естественно побеждать...",
