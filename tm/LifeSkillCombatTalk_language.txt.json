    "EvenContent_15": {
      "en": "Those who know when to yield are wise, this will do...",
      "cn": "识时务者为俊杰，如此也好……",
      "ru": "Те, кто знает, когда уступить, мудры, этого будет достаточно...",
      "status": "machine",
      "srcHash": "597344b8fba14059",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_16": {
      "en": "This text is so profound, do you truly understand?",
      "cn": "经中此篇如此高深，你当真懂得？",
      "ru": "Этот текст настолько глубок, вы действительно понимаете?",
      "status": "machine",
      "srcHash": "9c10c7009df2078d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_17": {
      "en": "Right and wrong must be settled in debate...",
      "cn": "是非对错，还需一辩方知……",
      "ru": "Правильное и неправильное должно решаться в ходе Диспута...",
      "status": "machine",
      "srcHash": "85788bedca8cb7ab",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_18": {
      "en": "The judgment is clear, it turns out I've lost...",
      "cn": "是非已定，原来是我败了……",
      "ru": "Решение ясное, оказывается, я проиграл...",
      "status": "machine",
      "srcHash": "b1b037c0112c241d",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EvenContent_19": {
      "en": "Deep research has brought me this victory...",
      "cn": "钻研至深，如今自能取胜……",
      "ru": "Глубокие исследования принесли мне эту победу...",
      "status": "machine",
      "srcHash": "7d48c74fea9c96d1",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_0": {
      "en": "It's not too late for you to concede!",
      "cn": "趁早认输还来得及！",
      "ru": "Тебе еще не поздно уступить!",
      "status": "machine",
      "srcHash": "ec8d297e550ec580",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_1": {
      "en": "Are you afraid?",
      "cn": "你是怕了不成？",
      "ru": "Ты боишься?",
      "status": "machine",
      "srcHash": "c192f4c0d45dd796",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_2": {
      "en": "Lack of proficiency is why you resorted to that...",
      "cn": "本事不足，方才如此……",
      "ru": "Недостаток мастерства - вот почему вы прибегли к этому...",
      "status": "machine",
      "srcHash": "72b79c033f41c741",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_3": {
      "en": "Don't try to play tricks...",
      "cn": "你可不要耍心眼……",
      "ru": "Не пытайся подшутить надо мной...",
      "status": "machine",
      "srcHash": "454264525ddf1041",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
