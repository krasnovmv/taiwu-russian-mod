    "EvenContent_15": {
      "en": "Those who know when to yield are wise, this will do...",
      "cn": "识时务者为俊杰，如此也好……",
      "ru": "Те, кто знает, когда уступить, мудры, этого будет достаточно...",
      "status": "machine",
      "srcHash": "01bf3b006dd45474",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_16": {
      "en": "This text is so profound, do you truly understand?",
      "cn": "经中此篇如此高深，你当真懂得？",
      "ru": "Этот текст настолько глубок, вы действительно понимаете?",
      "status": "machine",
      "srcHash": "4cb9b7c387718a92",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_17": {
      "en": "Right and wrong must be settled in debate...",
      "cn": "是非对错，还需一辩方知……",
      "ru": "Правильное и неправильное должно решаться в ходе диспута...",
      "status": "machine",
      "srcHash": "0d7857804b51e7e3",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "EvenContent_18": {
      "en": "The judgment is clear, it turns out I've lost...",
      "cn": "是非已定，原来是我败了……",
      "ru": "Решение ясное, оказывается, я проиграл...",
      "status": "machine",
      "srcHash": "b7626635894b9497",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_19": {
      "en": "Deep research has brought me this victory...",
      "cn": "钻研至深，如今自能取胜……",
      "ru": "Глубокие исследования принесли мне эту победу...",
      "status": "machine",
      "srcHash": "482b8c7e3f921186",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_0": {
      "en": "It's not too late for you to concede!",
      "cn": "趁早认输还来得及！",
      "ru": "Тебе еще не поздно уступить!",
      "status": "machine",
      "srcHash": "3ba5f3ec7337d360",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_1": {
      "en": "Are you afraid?",
      "cn": "你是怕了不成？",
      "ru": "Ты боишься?",
      "status": "machine",
      "srcHash": "c2a85ee3d46e16fb",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_2": {
      "en": "Lack of proficiency is why you resorted to that...",
      "cn": "本事不足，方才如此……",
      "ru": "Недостаток мастерства - вот почему вы прибегли к этому...",
      "status": "machine",
      "srcHash": "78aa984bedbfc212",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "RebelContent_3": {
      "en": "Don't try to play tricks...",
      "cn": "你可不要耍心眼……",
      "ru": "Не пытайся подшутить надо мной...",
      "status": "machine",
      "srcHash": "53b5754e8908737f",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
