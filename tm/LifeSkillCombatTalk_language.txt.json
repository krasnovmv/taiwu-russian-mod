    "JustContent_19": {
      "en": "I win! It was worth all the years of hard practice...",
      "cn": "我胜了！不枉多年刻苦修习……",
      "ru": "Я победил! Это стоило всех лет упорной практики...",
      "status": "machine",
      "srcHash": "94a62809f0bdd729",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "0ec9fb4bc1e781ed"
    },
    "KindContent_0": {
      "en": "You and I are merely expressing our own views...",
      "cn": "你我不过是各抒己见……",
      "ru": "Мы с вами просто выражаем наши собственные взгляды...",
      "status": "machine",
      "srcHash": "c4e1bf9addc6bad4",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z",
      "judgeHash": "caed2681ba6e5cbe"
    },
    "KindContent_1": {
      "en": "Then as you wish...",
      "cn": "便依你所愿……",
      "ru": "Тогда, как ты хочешь...",
      "status": "judged",
      "srcHash": "9a965da60b2e1d01",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "5befd182d9439594"
    },
    "KindContent_2": {
      "en": "Let me give you some leeway; it won't hurt...",
      "cn": "且让你一让，倒也无妨……",
      "ru": "Позволю тебе сделать шаг в сторону; в этом нет ничего страшного...",
      "status": "judged",
      "srcHash": "823dfa5de1e5da22",
      "engine": "yandex",
      "updatedAt": "2026-07-16T08:00:38.821Z",
      "judgeHash": "345c046a8e6fb637"
    },
    "KindContent_3": {
      "en": "No need to worry...",
      "cn": "无需心存顾虑……",
      "ru": "Не стоит беспокоиться...",
      "status": "machine",
      "srcHash": "ac6d4f62f18ac144",
