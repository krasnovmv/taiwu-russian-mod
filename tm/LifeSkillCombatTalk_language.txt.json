      "updatedAt": "2026-06-20T20:14:49.687Z"
    },
    "RebelContent_15": {
      "en": "Fine, it's no longer interesting to debate with you now!",
      "cn": "也罢，此时与你较艺亦是无趣！",
      "ru": "Ладно, теперь с тобой больше неинтересно Диспут вести!",
      "status": "machine",
      "srcHash": "5ee6b6a77b314c19",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "RebelContent_16": {
      "en": "If you bow out now, I will spare you this time!",
      "cn": "你若低头认输，我便饶你一回！",
      "ru": "Если ты сейчас откажешься, я пощажу тебя на этот раз!",
      "status": "machine",
      "srcHash": "ccfcfbc304693ce8",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "RebelContent_17": {
      "en": "You speak arrogantly, but who knows the outcome?",
      "cn": "口出狂言，却不知究竟鹿死谁手！",
      "ru": "Ты говоришь высокомерно, но кто знает, чем все закончится?",
      "status": "machine",
      "srcHash": "dc7cede97ec41fc9",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "RebelContent_18": {
      "en": "Strange, did you use any underhanded tricks?",
      "cn": "怪哉，莫不是你使了什么阴招？",
      "ru": "Странно, вы использовали какие-нибудь закулисные уловки?",
      "status": "machine",
      "srcHash": "7f5a1e1be93adf39",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "RebelContent_19": {
      "en": "Ha-ha! What else do you have to say?",
      "cn": "哈哈！你还有何话要说？",
      "ru": "Ха-ха! Что еще ты можешь сказать?",
      "status": "machine",
      "srcHash": "82b08f45d5776f5a",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
      "status": "machine",
      "srcHash": "b23a434d004adaa1",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "EgoisticContent_1": {
      "en": "This is still futile...",
      "cn": "此举亦是徒劳……",
      "ru": "Это все равно бесполезно...",
      "status": "machine",
      "srcHash": "0b249d9f68edfe05",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "EgoisticContent_2": {
      "en": "Why be so cautious?",
      "cn": "何必如此慎之又慎……",
      "ru": "Зачем быть таким осторожным?",
      "status": "machine",
      "srcHash": "940dbdf7cf96f416",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:06:46.416Z"
    },
    "EgoisticContent_3": {
      "en": "Show me your stuff.​..",
      "cn": "叫我瞧瞧你的能耐……",
      "ru": "Покажи мне свои вещи....",
      "status": "machine",
      "srcHash": "50af2aaa1330cff4",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
