    },
    "KindContent_16": {
      "en": "I prefer peace, would you be willing to concede?",
      "cn": "我愿以和为贵，你可愿就此服输？",
      "ru": "Я предпочитаю мир, готовы ли вы уступить?",
      "status": "machine",
      "srcHash": "73e32e113d304dea",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "KindContent_17": {
      "en": "How can we know who will win without a debate?",
      "cn": "未曾一辩，怎知谁胜谁负？",
      "ru": "Как мы можем узнать, кто победит, без диспута?",
      "status": "machine",
      "srcHash": "025aad07c81535fc",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этой области, я смиренно признаю свою неполноценность...",
      "status": "machine",
      "srcHash": "fcfc9ad31e9e3a33",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Победа или поражение решены, справедливость лежит в сердцах людей...",
      "status": "machine",
      "srcHash": "78d665b9c9608ea2",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, все будет оценено справедливо...",
      "status": "machine",
      "srcHash": "628cd002870a86e1",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
      "srcHash": "4ad22a22cc984fcc",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_2": {
      "en": "That seems reasonable...",
      "cn": "如此亦无不可……",
      "ru": "Это кажется разумным...",
      "status": "machine",
      "srcHash": "e60c97110046a5ea",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EvenContent_3": {
      "en": "Anything will do...",
      "cn": "皆可，皆可……",
      "ru": "Подойдет все, что угодно...",
      "status": "machine",
      "srcHash": "3f7ecb3631f063cb",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
