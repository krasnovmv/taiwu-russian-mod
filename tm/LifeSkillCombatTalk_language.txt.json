    "EgoisticContent_11": {
      "en": "Let me point you in the right direction...",
      "cn": "我便指点你一番……",
      "ru": "Позвольте мне указать вам правильное направление...",
      "status": "machine",
      "srcHash": "15f2c6009e7bf8c8",
