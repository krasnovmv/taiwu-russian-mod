    "JustContent_15": {
      "en": "You've outplayed me. I give up.",
      "cn": "你确实技艺过人，我认输！",
      "ru": "Ты переиграл меня. Я сдаюсь.",
      "status": "machine",
      "srcHash": "df1f16f18075c48a",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
    "JustContent_16": {
      "en": "If you are not as skilled, why not admit defeat?",
      "cn": "若你技不如人，何不知难而退？",
      "ru": "Если вы не столь опытны, почему бы не признать поражение?",
      "status": "machine",
      "srcHash": "0ef9b0413eb830f2",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "JustContent_17": {
      "en": "I see your skills are ordinary, you may not win!",
      "cn": "我观你技艺平平，未必能胜！",
      "ru": "Я вижу, что твои навыки заурядны, ты можешь и не победить!",
      "status": "machine",
      "srcHash": "bc72ddac6df097b8",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "JustContent_18": {
      "en": "Your skill is astonishing, I bow to you...",
      "cn": "是你技惊四座，我甘拜下风……",
      "ru": "Ваше мастерство поразительно, я преклоняюсь перед вами...",
      "status": "machine",
      "srcHash": "966fe0db8f3baf85",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "JustContent_19": {
      "en": "I win! It was worth all the years of hard practice...",
      "cn": "我胜了！不枉多年刻苦修习……",
      "ru": "Я победил! Это стоило всех лет упорной практики...",
      "status": "machine",
      "srcHash": "889335d89fca9b93",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_0": {
      "en": "You and I are merely expressing our own views...",
      "cn": "你我不过是各抒己见……",
      "ru": "Мы с вами просто выражаем наши собственные взгляды...",
      "status": "machine",
      "srcHash": "119565de2edae00e",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_1": {
      "en": "Then as you wish...",
      "cn": "便依你所愿……",
      "ru": "Тогда как вы пожелаете...",
      "status": "machine",
      "srcHash": "009421ccab5dedcd",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:06:46.416Z"
    },
    "KindContent_2": {
      "en": "Let me give you some leeway; it won't hurt...",
      "cn": "且让你一让，倒也无妨……",
      "ru": "Позволь мне дать тебе некоторую свободу действий; это не повредит...",
      "status": "machine",
      "srcHash": "67c38b7db4a12eb3",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_3": {
      "en": "No need to worry...",
      "cn": "无需心存顾虑……",
      "ru": "Не стоит беспокоиться...",
