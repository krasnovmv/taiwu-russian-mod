    "EvenContent_7": {
      "en": "If one chases trivial gains, one shall lose the Tao...",
      "cn": "若争小利，便失大道……",
      "ru": "Если кто-то гонится за тривиальными выгодами, он потеряет Дао...",
      "status": "machine",
