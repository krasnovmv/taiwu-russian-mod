    "KindContent_15": {
      "en": "I have lost my move, it's fine to stop here...",
      "cn": "我已棋输先着，无妨就此罢手……",
      "ru": "Я сбился с пути, можно остановиться здесь...",
      "status": "machine",
      "srcHash": "e0002f703bebbfd4",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_16": {
      "en": "I prefer peace, would you be willing to concede?",
      "cn": "我愿以和为贵，你可愿就此服输？",
      "ru": "Я предпочитаю мир, готовы ли вы уступить?",
      "status": "machine",
      "srcHash": "820243004e53afd1",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_17": {
      "en": "How can we know who will win without a debate?",
      "cn": "未曾一辩，怎知谁胜谁负？",
      "ru": "Как мы можем узнать, кто победит, без Диспута?",
      "status": "machine",
      "srcHash": "f56d58679d1a1a4f",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этой области, я смиренно признаю свою неполноценность...",
      "status": "machine",
      "srcHash": "89f1f148b02a66d8",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Победа или поражение решены, справедливость лежит в сердцах людей...",
      "status": "machine",
      "srcHash": "9542de2a2695afd8",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, все будет оценено справедливо...",
      "status": "machine",
      "srcHash": "b8864afa35ded5b1",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
      "srcHash": "cc33524f3d51b690",
      "engine": "yandex",
      "updatedAt": "2026-06-20T21:49:13.615Z"
    },
    "EvenContent_2": {
      "en": "That seems reasonable...",
      "cn": "如此亦无不可……",
      "ru": "Это кажется разумным...",
      "status": "machine",
      "srcHash": "87164969afd9301a",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:41:42.055Z"
    },
    "EvenContent_3": {
      "en": "Anything will do...",
      "cn": "皆可，皆可……",
      "ru": "Подойдет все, что угодно...",
      "status": "machine",
      "srcHash": "f47fea6cda178c93",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:06:46.416Z"
    },
