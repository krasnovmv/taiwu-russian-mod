    "RebelContent_15": {
      "en": "Fine, it's no longer interesting to debate with you now!",
      "cn": "也罢，此时与你较艺亦是无趣！",
      "ru": "Ладно, теперь с тобой больше неинтересно Диспут вести!",
      "status": "machine",
      "srcHash": "c683d40cab4fd76c",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "RebelContent_16": {
      "en": "If you bow out now, I will spare you this time!",
      "cn": "你若低头认输，我便饶你一回！",
      "ru": "Если ты сейчас откажешься, я пощажу тебя на этот раз!",
      "status": "machine",
      "srcHash": "c40373939cadd632",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "RebelContent_17": {
      "en": "You speak arrogantly, but who knows the outcome?",
      "cn": "口出狂言，却不知究竟鹿死谁手！",
      "ru": "Ты говоришь высокомерно, но кто знает, чем все закончится?",
      "status": "machine",
      "srcHash": "bf2617b6e86c9a8b",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "RebelContent_18": {
      "en": "Strange, did you use any underhanded tricks?",
      "cn": "怪哉，莫不是你使了什么阴招？",
      "ru": "Странно, вы использовали какие-нибудь закулисные уловки?",
      "status": "machine",
      "srcHash": "385ed2d438360b38",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "RebelContent_19": {
      "en": "Ha-ha! What else do you have to say?",
      "cn": "哈哈！你还有何话要说？",
      "ru": "Ха-ха! Что еще ты можешь сказать?",
      "status": "machine",
      "srcHash": "934fb1d33f234b39",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
      "status": "machine",
      "srcHash": "d1dd549f70ef1c63",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "EgoisticContent_1": {
      "en": "This is still futile...",
      "cn": "此举亦是徒劳……",
      "ru": "Это все равно бесполезно...",
      "status": "machine",
      "srcHash": "192afb3b184d0725",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "EgoisticContent_2": {
      "en": "Why be so cautious?",
      "cn": "何必如此慎之又慎……",
      "ru": "Зачем быть таким осторожным?",
      "status": "machine",
      "srcHash": "b9e8c4bc21f7fb32",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
    "EgoisticContent_3": {
      "en": "Show me your stuff.​..",
      "cn": "叫我瞧瞧你的能耐……",
      "ru": "Покажи мне свои вещи....",
      "status": "machine",
      "srcHash": "9cf45124aa70dd70",
      "engine": "yandex",
      "updatedAt": "2026-06-23T17:15:09.308Z"
    },
