      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "KindContent_18": {
      "en": "You are a master in this field, I humbly admit my inferiority...",
      "cn": "你精于此道，我自叹不如……",
      "ru": "Вы мастер в этой области, я смиренно признаю свою неполноценность...",
      "status": "machine",
      "srcHash": "79a48114cb1b6de9",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "KindContent_19": {
      "en": "Victory or defeat has been decided, fairness lies in the hearts of the people...",
      "cn": "胜败已分，公道自在人心……",
      "ru": "Победа или поражение решены, справедливость лежит в сердцах людей...",
      "status": "machine",
      "srcHash": "85ea90a515f1ad8f",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "EvenContent_0": {
      "en": "Everything will be judged fairly in the end...",
      "cn": "一切是非自有公论……",
      "ru": "В конце концов, все будет оценено справедливо...",
      "status": "machine",
      "srcHash": "7fc320d14436b8ae",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "EvenContent_1": {
      "en": "What a pity...",
      "cn": "可惜，可惜……",
      "ru": "Какая жалость...",
      "status": "machine",
      "srcHash": "2a6331083af38762",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "EvenContent_2": {
      "en": "That seems reasonable...",
      "cn": "如此亦无不可……",
      "ru": "Это кажется разумным...",
      "status": "machine",
      "srcHash": "4797b8257e5733fa",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "EvenContent_3": {
      "en": "Anything will do...",
      "cn": "皆可，皆可……",
      "ru": "Подойдет все, что угодно...",
      "status": "machine",
