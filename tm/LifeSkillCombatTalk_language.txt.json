    "JustContent_0": {
      "en": "Today's debate will reveal who is superior...",
      "cn": "今日一辩，便知高下……",
      "ru": "Сегодняшние диспуты покажут, кто из них лучше...",
      "status": "machine",
      "srcHash": "626430ee12cd6341",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "JustContent_1": {
      "en": "A resort to your advantage...",
      "cn": "不过是投机取巧……",
      "ru": "Курорт в ваших интересах...",
      "status": "machine",
      "srcHash": "53f80816ee038f41",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "JustContent_2": {
      "en": "Why bother with that if you're truly well-learned?",
      "cn": "若博学广识，何必如此大费周章？",
      "ru": "Зачем утруждать себя этим, если вы действительно хорошо образованы?",
      "status": "machine",
      "srcHash": "9b555a79ec673323",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "JustContent_3": {
      "en": "Choose as you like, I fear nothing!",
      "cn": "任你择选，我皆不惧！",
      "ru": "Выбирай, как тебе нравится, я ничего не боюсь!",
      "status": "machine",
      "srcHash": "f3b18b27b957d55f",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
