    "RebelContent_15": {
      "en": "Fine, it's no longer interesting to debate with you now!",
      "cn": "也罢，此时与你较艺亦是无趣！",
      "ru": "Ладно, теперь с тобой больше неинтересно Диспут вести!",
      "status": "machine",
      "srcHash": "82f83319d7c23d7b",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_16": {
      "en": "If you bow out now, I will spare you this time!",
      "cn": "你若低头认输，我便饶你一回！",
      "ru": "Если ты сейчас откажешься, я пощажу тебя на этот раз!",
      "status": "machine",
      "srcHash": "103097ed5c5e04db",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_17": {
      "en": "You speak arrogantly, but who knows the outcome?",
      "cn": "口出狂言，却不知究竟鹿死谁手！",
      "ru": "Ты говоришь высокомерно, но кто знает, чем все закончится?",
      "status": "machine",
      "srcHash": "b6e58e11b5c341de",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_18": {
      "en": "Strange, did you use any underhanded tricks?",
      "cn": "怪哉，莫不是你使了什么阴招？",
      "ru": "Странно, вы использовали какие-нибудь закулисные уловки?",
      "status": "machine",
      "srcHash": "a04577abfb7123b9",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "RebelContent_19": {
      "en": "Ha-ha! What else do you have to say?",
      "cn": "哈哈！你还有何话要说？",
      "ru": "Ха-ха! Что еще ты можешь сказать?",
      "status": "machine",
      "srcHash": "4ee8dcc99f2d5d62",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EgoisticContent_0": {
      "en": "I will win the match effortlessly...",
      "cn": "此番对阵，不费吹灰之力……",
      "ru": "Я выиграю этот матч без особых усилий...",
      "status": "machine",
      "srcHash": "d684b6c97cb3f856",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EgoisticContent_1": {
      "en": "This is still futile...",
      "cn": "此举亦是徒劳……",
      "ru": "Это все равно бесполезно...",
      "status": "machine",
      "srcHash": "8b1b35b0c3593fd6",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EgoisticContent_2": {
      "en": "Why be so cautious?",
      "cn": "何必如此慎之又慎……",
      "ru": "Зачем быть таким осторожным?",
      "status": "machine",
      "srcHash": "f15a28f65c6e0888",
      "engine": "yandex",
      "updatedAt": "2026-07-01T23:51:17.774Z"
    },
    "EgoisticContent_3": {
      "en": "Show me your stuff.​..",
      "cn": "叫我瞧瞧你的能耐……",
      "ru": "Покажи мне свои вещи....",
      "status": "machine",
      "srcHash": "a0c1e766bb2ebdf6",
      "engine": "yandex",
