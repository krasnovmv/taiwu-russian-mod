    "NormalContent_4": {
      "en": "I have heard of something before, do you know it?",
      "cn": "我此前获悉一事，不知你可曾知晓……",
      "ru": "Я уже слышал кое о чем раньше, знаете ли вы это?",
      "status": "machine",
      "srcHash": "b90842243bebd719",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "NormalContent_5": {
      "en": "You truly understand the situation well...",
      "cn": "你果然深明事理……",
      "ru": "Вы действительно хорошо понимаете ситуацию...",
      "status": "machine",
      "srcHash": "6e43416ac41c0d80",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "NormalContent_6": {
      "en": "What does it matter if you know this? There's no need to say more...",
      "cn": "知晓此事又能如何？你不必多言……",
      "ru": "Какое это имеет значение, если ты это знаешь? Больше ничего говорить не нужно...",
      "status": "machine",
      "srcHash": "b35985678acd28eb",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "NormalContent_7": {
      "en": "",
      "cn": "",
      "ru": "",
      "status": "machine",
      "srcHash": "166f829e016f2315",
      "engine": "yandex",
      "updatedAt": "2026-06-20T20:14:49.687Z"
    },
    "NormalContent_8": {
      "en": "There's something I've heard of before, do you remember it?",
      "cn": "此前曾有一事，不知你可还记得？",
      "ru": "Есть кое-что, о чем я слышал раньше, ты помнишь это?",
      "status": "machine",
      "srcHash": "40a4b0dabd15e847",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "NormalContent_9": {
      "en": "Could these items be of some convenience to you?",
      "cn": "不知此些物什，可能令你行些方便？",
      "ru": "Могут ли эти предметы быть вам полезны?",
      "status": "machine",
      "srcHash": "34252969dbe34584",
      "engine": "yandex",
      "updatedAt": "2026-06-20T23:07:40.560Z"
    },
    "NormalContent_10": {
      "en": "So it's settled, no backing out.",
      "cn": "一言已定，不可反悔……",
      "ru": "Так что все улажено, отступать некуда.",
      "status": "machine",
      "srcHash": "9925e3d2bebdb981",
      "engine": "yandex",
      "updatedAt": "2026-06-20T22:52:55.908Z"
    },
