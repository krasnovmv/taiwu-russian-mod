    "KindContent_7": {
      "en": "I am not someone who seeks profit at the expense of honor...",
      "cn": "我却并非趋利避害之辈……",
      "ru": "Я не из тех, кто ищет выгоды за счет чести...",
      "status": "machine",
      "srcHash": "0fbbb9688121d5e4",
      "engine": "yandex",
