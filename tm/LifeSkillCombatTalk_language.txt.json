    "JustContent_0": {
      "en": "Today's debate will reveal who is superior...",
      "cn": "今日一辩，便知高下……",
      "ru": "Сегодняшние Диспуты покажут, кто из них лучше...",
      "status": "machine",
      "srcHash": "7b870e71c9b56274",
      "engine": "yandex",
      "updatedAt": "2026-07-02T16:21:30.980Z"
    },
    "JustContent_1": {
      "en": "A resort to your advantage...",
      "cn": "不过是投机取巧……",
      "ru": "Курорт в ваших интересах...",
      "status": "machine",
      "srcHash": "5fd9b164d6aa24e0",
