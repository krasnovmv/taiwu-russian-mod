    "EgoisticContent_15": {
      "en": "It's futile to continue without strategy, I'll retreat for now...",
      "cn": "无谋之事不可为，我便暂且退避……",
      "ru": "Бесполезно продолжать без стратегии, я пока отступлю...",
      "status": "machine",
      "srcHash": "b4c58f3c59ef5fcf",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_16": {
      "en": "Do you really have the skill to debate with me?",
      "cn": "你此等技艺，也能上阵与我较艺？",
      "ru": "У тебя действительно есть навыки, чтобы диспут со мной вести?",
      "status": "machine",
      "srcHash": "225a8298d9b9235e",
      "engine": "yandex",
      "updatedAt": "2026-07-10T22:05:17.320Z"
    },
    "EgoisticContent_17": {
      "en": "With such abilities, how can you be so bold?",
      "cn": "你何等本事，口气竟如此狂妄？",
      "ru": "Обладая такими способностями, как ты можешь быть таким смелым?",
      "status": "machine",
      "srcHash": "103b09380d982d05",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_18": {
      "en": "Next time, I may turn the tables...",
      "cn": "下回再辩，我未尝不能反败为胜……",
      "ru": "В следующий раз я, возможно, поменяюсь ролями...",
      "status": "machine",
      "srcHash": "f5b83eafa4582092",
      "engine": "yandex",
      "updatedAt": "2026-07-03T21:32:41.679Z"
    },
    "EgoisticContent_19": {
      "en": "It is only natural for me to win...",
      "cn": "我能得胜，也是理所应当……",
      "ru": "Для меня вполне естественно побеждать...",
