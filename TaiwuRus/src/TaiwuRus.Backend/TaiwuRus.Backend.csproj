<Project Sdk="Microsoft.NET.Sdk">

    <!-- Common properties (LangVersion, GameDir, …) come from src/Directory.Build.props;
         the deploy-to-game step from src/Directory.Build.targets (enabled via DeployMod). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>TaiwuRusB</AssemblyName>
        <RootNamespace>TaiwuRus.Backend</RootNamespace>
        <!-- Plugin is loaded into the running game host; a deps.json is unneeded and can confuse resolution. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <!-- Both plugins build into the shared mod package folder. -->
        <OutputPath>..\..\dist\Plugins\</OutputPath>
        <DeployMod>true</DeployMod>
        <BackendDir>$(GameDir)\Backend</BackendDir>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\TaiwuRus.Shared\ModInfo.cs" Link="ModInfo.cs" />
        <Compile Include="..\TaiwuRus.Shared\OverlayDeployer.cs" Link="OverlayDeployer.cs" />
        <Compile Include="..\TaiwuRus.Shared\RuLocale.cs" Link="RuLocale.cs" />
    </ItemGroup>

    <!-- Compile-checked typed access to the game's private/internal backend members.
         A renamed type/method/field now breaks the BUILD instead of silently no-op'ing. -->
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
        <Publicize Include="GameData" />
    </ItemGroup>

    <!-- Backend (.NET 8) assemblies. Private=false: they ship with the game. -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(BackendDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="TaiwuModdingLib">
            <HintPath>$(BackendDir)\TaiwuModdingLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameData">
            <HintPath>$(BackendDir)\GameData.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameData.Shared">
            <HintPath>$(BackendDir)\GameData.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameData.Utilities">
            <HintPath>$(BackendDir)\GameData.Utilities.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
