<Project Sdk="Microsoft.NET.Sdk">

    <!-- Common properties (LangVersion, GameDir, …) come from src/Directory.Build.props;
         the deploy-to-game step from src/Directory.Build.targets (enabled via DeployMod). -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>TaiwuRusF</AssemblyName>
        <RootNamespace>TaiwuRus.Frontend</RootNamespace>
        <!-- Both plugins build into the shared mod package folder. -->
        <OutputPath>..\..\dist\Plugins\</OutputPath>
        <DeployMod>true</DeployMod>
        <ManagedDir>$(GameDir)\The Scroll of Taiwu_Data\Managed</ManagedDir>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\TaiwuRus.Shared\AssemblyVersionInfo.cs" Link="AssemblyVersionInfo.cs" />
        <Compile Include="..\TaiwuRus.Shared\HarmonyPatching.cs" Link="HarmonyPatching.cs" />
        <Compile Include="..\TaiwuRus.Shared\ModInfo.cs" Link="ModInfo.cs" />
        <Compile Include="..\TaiwuRus.Shared\OverlayDeployer.cs" Link="OverlayDeployer.cs" />
        <Compile Include="..\TaiwuRus.Shared\RuImageName.cs" Link="RuImageName.cs" />
        <Compile Include="..\TaiwuRus.Shared\RuLocale.cs" Link="RuLocale.cs" />
    </ItemGroup>

    <!-- Build-order only (no assembly reference): both projects deploy dist/ into the game
         after build, and running the two DeployToGame copies in parallel races on the other
         plugin's freshly written dll/pdb. Serializing the builds removes the overlap. -->
    <ItemGroup>
        <ProjectReference Include="..\TaiwuRus.Backend\TaiwuRus.Backend.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true" />
    </ItemGroup>

    <!-- Lets net48 build without a machine-wide Developer Pack. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    </ItemGroup>

    <!-- Compile-checked typed access to the game's private/internal frontend members.
         A renamed type/method/field now breaks the BUILD instead of silently no-op'ing. -->
    <ItemGroup>
        <Publicize Include="Assembly-CSharp" />
    </ItemGroup>

    <!-- Frontend (Unity/Mono) assemblies. Private=false: they ship with the game. -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="TaiwuModdingLib">
            <HintPath>$(ManagedDir)\TaiwuModdingLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameData.Shared">
            <HintPath>$(ManagedDir)\GameData.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
