<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>TaiwuRusF</AssemblyName>
        <RootNamespace>TaiwuRus.Frontend</RootNamespace>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Both plugins build into the shared mod package folder. -->
        <OutputPath>..\..\dist\Plugins\</OutputPath>

        <!-- Game install root. Override with -p:GameDir=... or env TAIWU_GAME_DIR. -->
        <GameDir Condition="'$(GameDir)' == '' and '$(TAIWU_GAME_DIR)' != ''">$(TAIWU_GAME_DIR)</GameDir>
        <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\The Scroll Of Taiwu</GameDir>
        <ManagedDir>$(GameDir)\The Scroll of Taiwu_Data\Managed</ManagedDir>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\TaiwuRus.Shared\ModInfo.cs" Link="ModInfo.cs" />
    </ItemGroup>

    <!-- Lets net48 build without a machine-wide Developer Pack. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    </ItemGroup>

    <!-- Compile-checked typed access to the game's private/internal frontend members.
         A renamed type/method/field now breaks the BUILD instead of silently no-op'ing. -->
    <ItemGroup>
        <Publicize Include="Assembly-CSharp" />
    </ItemGroup>

    <!-- Frontend (Unity/Mono) assemblies. Private=false: they ship with the game. -->
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="TaiwuModdingLib">
            <HintPath>$(ManagedDir)\TaiwuModdingLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="GameData.Shared">
            <HintPath>$(ManagedDir)\GameData.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- After build, deploy the whole mod package (dist/) into the game's Mod folder. -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)')">
        <PropertyGroup>
            <ModDeployDir>$(GameDir)\Mod\TaiwuRus</ModDeployDir>
            <DistDir>$(MSBuildProjectDirectory)\..\..\dist</DistDir>
        </PropertyGroup>
        <ItemGroup>
            <DeployFiles Include="$(DistDir)\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(DeployFiles)"
              DestinationFiles="@(DeployFiles->'$(ModDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Message Importance="high" Text="[TaiwuRus] deployed dist -&gt; $(ModDeployDir)" />
    </Target>

</Project>
