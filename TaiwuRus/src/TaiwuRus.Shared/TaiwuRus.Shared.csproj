<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Shared code for both plugins. It is NOT deployed on its own: its source
      files are linked into the Frontend (net48) and Backend (net8.0) projects
      so each assembly stays self-contained for its runtime.
    -->
    <!-- Common properties (LangVersion, Nullable, …) come from src/Directory.Build.props. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>TaiwuRus.Shared</RootNamespace>
    </PropertyGroup>

    <!-- RuLocale references LocalStringManager (GameData.Shared), which this standalone project
         does not reference; the file is source-linked into Frontend and Backend only. -->
    <ItemGroup>
        <Compile Remove="RuLocale.cs" />
    </ItemGroup>

</Project>
