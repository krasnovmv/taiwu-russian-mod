<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Game install root. Override per machine, e.g. -p:TaiwuDir="C:\...". -->
        <TaiwuDir Condition="'$(TaiwuDir)' == ''">D:\SteamLibrary\steamapps\common\The Scroll Of Taiwu</TaiwuDir>
        <ManagedDir>$(TaiwuDir)\The Scroll of Taiwu_Data\Managed</ManagedDir>
        <!-- Where the built plugin is deployed for local testing (game Mod folder). -->
        <ModDeployDir>$(TaiwuDir)\Mod\TaiwuRus</ModDeployDir>
    </PropertyGroup>

    <!-- Frontend (Unity/Mono) assemblies. Private=false: they already ship with the game. -->
    <ItemGroup>
        <Reference Include="TaiwuModdingLib">
            <HintPath>$(ManagedDir)\TaiwuModdingLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- After build, copy the plugin + mod config into the game's Mod folder for testing. -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(TaiwuDir)')">
        <MakeDir Directories="$(ModDeployDir)\Plugins" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)\Plugins" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModDeployDir)\Plugins" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\dist\Config.Lua;$(MSBuildProjectDirectory)\dist\Settings.Lua" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="[TaiwuRus] deployed to $(ModDeployDir)" />
    </Target>

</Project>
